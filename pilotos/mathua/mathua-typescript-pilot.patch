+		if res["correct"] != false || !strings.Contains(res["feedback"].(string), "const") || res["explanation"] == "" {
+			t.Fatalf("missing specific correction: %+v", res)
+		}
+		t.Logf("miss: %s | answer: %s | feedback: %v", q, wrong, res["feedback"])
+		correctQuestion = e.question(t, token, constID, q)
