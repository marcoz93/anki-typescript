--- /dev/null
+++ b/cmd/typescript-pilot/grade.cjs
@@ -0,0 +1,88 @@
+'use strict';
+
+// This is a narrow static grader. Learner code is never evaluated or emitted.
+const ts = require('typescript');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const result = (correct, feedback) => ({correct, score: correct ? 1 : 0, feedback});
+const parse = source => ts.createSourceFile('answer.ts', source, ts.ScriptTarget.ES2022, true);
+
+function declaration(sf) {
+  const statement = sf.statements.length === 1 && sf.statements[0];
+  if (!statement || !ts.isVariableStatement(statement) || statement.modifiers?.length) return null;
+  const list = statement.declarationList;
+  if (list.declarations.length !== 1) return null;
+  return {list, item: list.declarations[0]};
+}
+
+function typeErrors(source) {
+  const filename = path.resolve(__dirname, '__answer__.ts');
+  const options = {strict: true, noEmit: true, types: [], skipLibCheck: true, target: ts.ScriptTarget.ES2022};
+  const host = ts.createCompilerHost(options);
+  const library = path.dirname(ts.getDefaultLibFilePath(options));
+  const read = host.readFile.bind(host);
+  // Only compiler library files are accessible. Triple-slash paths in an answer
+  // cannot make the checker read other project or host files.
+  const allowed = file => path.dirname(path.resolve(file)) === library && /^lib(?:\..+)?\.d\.ts$/.test(path.basename(file));
+  host.readFile = file => path.resolve(file) === filename ? source : allowed(file) ? read(file) : undefined;
+  host.fileExists = file => path.resolve(file) === filename || (allowed(file) && ts.sys.fileExists(file));
+  host.getSourceFile = (file, languageVersion) => {
+    const content = host.readFile(file);
+    return content === undefined ? undefined : ts.createSourceFile(file, content, languageVersion, true);
+  };
+  const program = ts.createProgram([filename], options, host);
+  return ts.getPreEmitDiagnostics(program).map(d => ts.flattenDiagnosticMessageText(d.messageText, '\n'));
+}
+
+function grade({kind, expected, answer}) {
+  if (typeof expected !== 'string' || typeof answer !== 'string') throw new Error('Invalid grader input');
+  if (!answer.trim()) return result(false, 'Digite a resposta solicitada.');
+  if (answer.length > 4096) return result(false, 'A resposta excede o tamanho deste exercício.');
+  if (kind === 'type') {
+    if (expected !== 'number') throw new Error('Invalid reference type');
+    return result(answer.trim() === 'number', answer.trim() === 'number'
+      ? 'Correto. number nomeia o tipo numérico.'
+      : 'Use number para nomear o tipo numérico. Um literal como 15000 representa um valor, não o nome do tipo.');
+  }
+  const sf = parse(answer);
+  if (sf.parseDiagnostics.length) return result(false, 'A resposta contém um erro de sintaxe TypeScript.');
+  if (kind === 'literal') {
+    const stmt = sf.statements.length === 1 && sf.statements[0];
+    const expr = stmt && ts.isExpressionStatement(stmt) && stmt.expression;
+    if (!expr || !ts.isNumericLiteral(expr)) return result(false, 'Use somente um literal numérico, sem aspas e sem operações.');
+    if (Number(expr.text) !== Number(expected)) return result(false, 'O literal representa um valor diferente do solicitado.');
+    return result(true, 'Correto. O literal representa o valor solicitado.');
+  }
+  if (kind !== 'const') throw new Error('Unknown exercise kind');
+  const reference = declaration(parse(expected));
+  if (!reference || !ts.isIdentifier(reference.item.name) || !ts.isNumericLiteral(reference.item.initializer)) {
+    throw new Error('Invalid reference declaration');
+  }
+  const actual = declaration(sf);
+  if (!actual) return result(false, 'Escreva somente uma declaração de constante, com um único nome.');
+  if (!(actual.list.flags & ts.NodeFlags.Const)) return result(false, 'A tarefa pede const, que impede reatribuir esse nome após a inicialização. let permite reatribuição.');
+  if (!ts.isIdentifier(actual.item.name) || actual.item.name.text !== reference.item.name.text) {
+    return result(false, `Use o nome solicitado: ${reference.item.name.text}.`);
+  }
+  const init = actual.item.initializer;
+  if (!init || !ts.isNumericLiteral(init)) return result(false, 'Inicialize a constante com um literal numérico, sem aspas e sem operações.');
+  if (Number(init.text) !== Number(reference.item.initializer.text)) return result(false, 'O valor inicial difere do solicitado.');
+  if (actual.item.type && actual.item.type.kind !== ts.SyntaxKind.NumberKeyword) {
+    return result(false, 'Neste exercício, omita a anotação ou use number, como indicado no enunciado.');
+  }
+  const errors = typeErrors(answer);
+  if (errors.length) return result(false, `O compilador TypeScript rejeitou a declaração: ${errors[0]}`);
+  return result(true, 'Correto. A constante tem o nome e o valor solicitados. A anotação number é opcional neste exercício.');
+}
+
+if (require.main === module) {
+  try {
+    process.stdout.write(JSON.stringify(grade(JSON.parse(fs.readFileSync(0, 'utf8')))));
+  } catch (error) {
+    process.stderr.write(error.message + '\n');
+    process.exitCode = 1;
+  }
+}
+
+module.exports = {grade};
