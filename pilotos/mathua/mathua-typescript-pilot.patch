+		_, practice := e.request(t, "GET", "/api/lessons/"+constID+"/practice", token, nil, 403)
+		_, answer := e.request(t, "POST", "/api/study/answer", token, submission(constID, "", "const amount = 15000;", "locked"), 403)
+		if !strings.Contains(practice, "TOPIC_LOCKED") || !strings.Contains(answer, "TOPIC_LOCKED") {
