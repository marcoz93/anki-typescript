@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest'
+import { pilotAdmit, pilotExclude, pilotFresh, pilotUsable } from '../lib/pilot'
+
+// The pilot serves a bank of six cases per section. These helpers decide what a practice fetch
+// excludes, so that the bank rotates and a missed question does not come straight back.
+const BANK = ['a', 'b', 'c', 'd', 'e', 'f']
+const left = (shown: string[], buffered: string[]) => BANK.filter(q => !pilotExclude(shown, buffered).includes(q))
+
+describe('pilotExclude', () => {
+  it('excludes nothing before anything was shown', () => {
+    expect(pilotExclude([], [])).toEqual([])
+  })
+
+  it('leaves the case shown longest ago once the whole bank was shown', () => {
+    expect(left(['a', 'b', 'c', 'd', 'e'], [])).toEqual(['f'])
+    expect(left(['a', 'b', 'c', 'd', 'e', 'f'], [])).toEqual(['a'])
+    expect(left(['a', 'b', 'c', 'd', 'e', 'f', 'a'], [])).toEqual(['b'])
+  })
+
+  it('always leaves a candidate, and never the question just shown, however full the buffer is', () => {
+    for (let shownCount = 1; shownCount <= 7; shownCount++) {
+      for (let bufferCount = 0; bufferCount <= 6; bufferCount++) {
+        const shown = Array.from({ length: shownCount }, (_, i) => BANK[i % 6])
+        const buffered = BANK.filter(q => q !== shown[shown.length - 1]).slice(0, bufferCount)
+        const candidates = left(shown, buffered)
+        expect(candidates.length).toBeGreaterThan(0)
+        expect(candidates).not.toContain(shown[shown.length - 1])
+        expect(pilotExclude(shown, buffered).length).toBeLessThanOrEqual(5)
+      }
+    }
+  })
+
+  it('keeps the missed question out when the buffer already holds the other five', () => {
+    expect(left(['a'], ['b', 'c', 'd', 'e', 'f'])).toEqual(['f'])
+  })
+})
+
+describe('pilotFresh', () => {
+  const q = (question: string) => ({ question })
+
+  it('keeps each fetched question once and drops what is already buffered', () => {
+    expect(pilotFresh([q('a'), q('a'), q('b'), q('c')], ['c'])).toEqual([q('a'), q('b')])
+  })
+
+  it('makes two overlapping fetches add each question once', () => {
+    let buffer = ['a', 'b']
+    for (const fetched of [['c', 'd', 'e'], ['e', 'c', 'd']]) {
+      buffer = [...buffer, ...pilotFresh(fetched.map(q), buffer).map(item => item.question)]
+    }
+    expect(buffer).toEqual(['a', 'b', 'c', 'd', 'e'])
+  })
+})
+
+describe('pilotAdmit', () => {
+  const q = (question: string) => ({ question })
+
+  it('does not bring back a question that was shown while the fetch was on its way', () => {
+    // The fetch was sent before `f` was shown; it arrives carrying `f` again.
+    expect(pilotAdmit([q('f'), q('a')], [], ['b', 'c', 'd', 'e', 'f'])).toEqual([q('a')])
+  })
+
+  it('admits the case shown longest ago and nothing shown in the last five', () => {
+    expect(pilotAdmit(BANK.map(q), [], ['a', 'b', 'c', 'd', 'e', 'f'])).toEqual([q('a')])
+  })
+
+  it('adds nothing twice when two fetches and a recovery fetch overlap', () => {
+    let buffer = ['c', 'd', 'e']
+    for (const fetched of [['f', 'd', 'e'], ['f', 'd'], ['e', 'f']]) {
+      buffer = [...buffer, ...pilotAdmit(fetched.map(q), buffer, ['a', 'b']).map(item => item.question)]
+    }
+    expect(buffer).toEqual(['c', 'd', 'e', 'f'])
+  })
+})
+
+describe('pilotUsable', () => {
+  const q = (question: string) => ({ question })
+
+  it('is what pilotAdmit lets through when that is something', () => {
+    expect(pilotUsable([q('a'), q('f')], ['b', 'c', 'd', 'e', 'f'])).toEqual([q('a')])
+  })
+
+  it('never leaves the page without a question because of the pilot filter', () => {
+    // The fetch excluded a full buffer, so the server could only send a case shown three questions ago.
+    expect(pilotUsable([q('a')], ['a', 'b', 'c'])).toEqual([q('a')])
+  })
+
+  it('still refuses the question shown last', () => {
+    expect(pilotUsable([q('c'), q('a')], ['a', 'b', 'c'])).toEqual([q('a')])
+    expect(pilotUsable([q('c')], ['a', 'b', 'c'])).toEqual([])
+  })
+})
