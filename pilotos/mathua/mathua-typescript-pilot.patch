+func TestSectionsKeepOneFamilyAndLessonsLoad(t *testing.T) {
+	_, c := testContent(t)
+	check := testChecker(t)
+	var twoFamilies conceptSpec
+	for _, spec := range c.Concepts {
+		if spec.ID == "ts.binding.const_semantics" {
+			twoFamilies = spec
+		}
+	}
+	if len(twoFamilies.FamilyIDs) != 2 {
+		t.Fatalf("fixture concept has families %v", twoFamilies.FamilyIDs)
+	}
+	item, err := newExercise(twoFamilies, c.familiesOf(twoFamilies), check)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Section N serves family N only, and reaches all of its cases before any repeats.
+	for section, familyID := range twoFamilies.FamilyIDs {
+		seen := map[string]bool{}
+		for draw := 0; draw < len(c.families[familyID].Cases); draw++ {
+			p := item.Generate(generator.GeneratorContext{Seed: 41, KPOrdinal: section + 1})
+			gotFamily, caseID, ok := c.lookup(twoFamilies.ID, p.Question)
+			if !ok || gotFamily != familyID || seen[caseID] {
+				t.Fatalf("section %d served %s %s (repeat=%t)", section+1, gotFamily, caseID, seen[caseID])
+			}
+			seen[caseID] = true
+			if got := item.Grade(p.Answer, p.Answer); !got.Correct {
+				t.Fatalf("%s: reference answer rejected: %+v", caseID, got)
+			}
+		}
+	}
+	// A reference answer from another content version is a technical failure, not an error.
+	if got := item.Grade("alternativa que não existe nesta versão", "A"); !got.Unavailable {
+		t.Fatalf("unknown reference must be ungraded: %+v", got)
+	}
+	dir := t.TempDir()
+	if err := c.writeLessons(dir); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := lessons.Load(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, spec := range c.Concepts {
+		points := loaded.KPs(spec.ID)
+		if len(points) != len(spec.FamilyIDs) {
+			t.Fatalf("%s: %d sections for %d families", spec.ID, len(points), len(spec.FamilyIDs))
+		}
+		for _, point := range points {
+			body, ok := loaded.KPSectionBody(spec.ID, point.Section)
+			if !ok || !strings.Contains(body, strings.TrimSpace(c.lessons[spec.Stage])) {
+				t.Fatalf("%s: section %q does not carry the stage lesson", spec.ID, point.Section)
+			}
+		}
+	}
+}
+
+// The engine resolves the letter of an alternative against the served question. A new concept of
+// the package is answered that way, and a miss leaves the learner a variant of the same family.
+func TestChoiceIsAnsweredByLetterThroughTheAPI(t *testing.T) {
+	t.Setenv("MATHUA_DEV_UNLOCK", "")
+	_, c := testContent(t)
+	e := boot(t, filepath.Join(t.TempDir(), "choice.db"), testChecker(t))
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	guest, _ := e.request(t, "POST", "/api/auth/guest", "", map[string]any{}, 200)
+	token := guest["token"].(string)
+	const concept = "ts.value.literal_notation"
+	first := e.question(t, token, concept)
+	letter := solve(t, concept, first)
+	wrong := "A"
+	if letter == "A" {
+		wrong = "B"
+	}
+	res, raw := e.request(t, "POST", "/api/study/answer", token, submission(concept, first, wrong, "choice-miss"), 200)
+	if res["correct"] != false || res["ungraded"] == true || res["explanation"] == "" {
+		t.Fatalf("wrong alternative: %s", raw)
+	}
+	next := e.question(t, token, concept, first)
+	firstFamily, firstCase, _ := c.lookup(concept, first)
+	nextFamily, nextCase, ok := c.lookup(concept, next)
+	if !ok || nextFamily != firstFamily || nextCase == firstCase {
+		t.Fatalf("variant after a miss: %s %s after %s %s", nextFamily, nextCase, firstFamily, firstCase)
+	}
+	res, raw = e.request(t, "POST", "/api/study/answer", token, submission(concept, next, strings.ToLower(solve(t, concept, next)), "choice-hit"), 200)
+	if res["correct"] != true || res["ungraded"] == true || strings.TrimSpace(res["expected_answer"].(string)) == "" {
+		t.Fatalf("lowercase letter of the correct alternative: %s", raw)
+	}
+	t.Logf("%s: missed %s with %s, then %s accepted by letter; reference shown: %s", firstFamily, firstCase, wrong, nextCase, res["expected_answer"])
+}
