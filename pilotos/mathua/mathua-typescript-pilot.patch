+// Findings of the independent reviewer (Codex, read-only) on blocks 1 and 2, each one reproduced
+// before the fix. The answers are the ones it reported; the context is the case's own.
+func TestFindingsOfTheIndependentReview(t *testing.T) {
+	check := testChecker(t)
+	const twoBooleans = "const isSigned: boolean = true;\nconst hasPages: boolean = false;"
+	const expense = `const expense = { id: "r11", total: 18000 };`
+	cases := []struct {
+		name, family, context, reference, answer string
+		correct                                  bool
+		feedback                                 string
+	}{
+		// 1. A triple-slash directive made the compiler load something else and was accepted.
+		{"f002_reference_directive", "F002", "", "18000", "/// <reference lib=\"invalidlib\" />\n18_000", false, "diretiva"},
+		{"f016_reference_directive", "F016", "const amount = 15000;", "amount > 10000", "/// <reference lib=\"invalidlib\" />\namount > 10000", false, "diretiva"},
+		{"f010_reference_directive", "F010", "", "const amount: number = 15000;", "/// <reference path=\"missing.ts\" />\nconst amount: number = 15000;", false, "diretiva"},
+		// 2. Valid answers that were rejected.
+		{"f010_literal_type_annotation", "F010", "", "const total: number = 18000;", "const total: 18000 = 18_000;", true, ""},
+		{"f010_union_annotation", "F010", "", "const total: number = 18000;", "const total: number | string = 18000;", true, ""},
+		{"f011_parenthesized_annotation", "F011", "", `const id: string = "reembolso-21";`, `const id: (string) = "reembolso-21";`, true, ""},
+		{"f021_computed_text_key", "F021", "", expense, `const expense = { ["id"]: "r11", total: 18000 };`, true, ""},
+		{"f022_parenthesized_key", "F022", `const request = { id: "r21", value: 9000 };`, "request.value", `request[("value")]`, true, ""},
+		// The annotation stays a criterion: it must fit the value and say something about it.
+		{"f010_any_annotation", "F010", "", "const total: number = 18000;", "const total: any = 18000;", false, "any"},
+		{"f010_unknown_annotation", "F010", "", "const total: number = 18000;", "const total: unknown = 18000;", false, "unknown"},
+		{"f010_incompatible_annotation", "F010", "", "const total: number = 18000;", "const total: string = 18000;", false, "not assignable"},
+		// 3. Messages that named a cause the answer did not have.
+		{"f021_sum_is_not_a_wrong_value", "F021", "", expense, `const expense = { id: "r11", total: 12000 + 6000 };`, false, "sem operações"},
+		{"f021_assertion_is_not_a_missing_object", "F021", "", expense, expense[:len(expense)-1] + " as const;", false, "asserção"},
+		{"f023_assertion_is_not_a_missing_array", "F023", "", "const totals = [18000, 4000, 12000];", "const totals = [18000, 4000, 12000] as const;", false, "asserção"},
+		{"f019_comparisons_inside_and", "F019", twoBooleans, "isSigned && hasPages", "isSigned === true && hasPages === true", false, "diretamente"},
+		// Second pass: the same classes, where the first fix judged by the text of the answer.
+		{"f002_directive_in_capitals", "F002", "", "18000", "/// <REFERENCE lib=\"invalidlib\" />\n18_000", false, "diretiva"},
+		{"f002_directive_text_inside_a_comment_is_a_comment", "F002", "", "18000", "/*\n/// <reference lib=\"invalidlib\" />\n*/\n18_000", true, ""},
+		{"f003_text_with_three_slashes", "F003", "", `"///"`, `"///"`, true, ""},
+		{"f010_annotation_that_resolves_to_number", "F010", "", "const total: number = 18000;", "const total: number & unknown = 18_000;", true, ""},
+		{"f010_annotation_that_resolves_to_any", "F010", "", "const total: number = 18000;", "const total: ReturnType<typeof JSON.parse> = 18_000;", false, "any"},
+		{"f011_annotation_that_resolves_to_any", "F011", "", `const id: string = "reembolso-21";`, `const id: ReturnType<typeof Object.create> = "reembolso-21";`, false, "any"},
+		{"f021_key_in_backticks", "F021", "", expense, "const expense = { [`id`]: \"r11\", total: 18000 };", true, ""},
+		{"f022_key_in_backticks", "F022", `const request = { id: "r21", value: 9000 };`, "request.value", "request[`value`]", true, ""},
+		// Third pass: two messages that named a cause the answer did not have.
+		{"f019_or_is_true_with_one_or_both", "F019", twoBooleans, "isSigned && hasPages", "isSigned || hasPages", false, "quando só uma delas"},
+		{"f021_shorthand_property_has_its_name", "F021", "", expense, "const expense = { id, total: 18000 };", false, "junto com o nome"},
+		{"f021_method_is_not_a_missing_property", "F021", "", expense, "const expense = { id() { return 1; }, total: 18000 };", false, "nome: valor"},
+		// Fourth pass.
+		{"f023_let_declares_the_requested_array", "F023", "", "const totals = [18000, 4000, 12000];", "let totals = [18000, 4000, 12000];", true, ""},
+		{"f023_let_keeps_the_order_criterion", "F023", "", "const totals = [18000, 4000, 12000];", "let totals = [4000, 18000, 12000];", false, "outra ordem"},
+		{"f021_object_task_names_const", "F021", "", expense, "let expense = { id: \"r11\", total: 18000 };", false, "const"},
+		{"f010_misspelled_type_is_not_an_incompatible_value", "F010", "", "const amount: number = 15000;", "const amount: numbr = 15000;", false, "Cannot find name"},
+		// Fifth pass: a declaration written with let was called a constant.
+		{"f023_let_with_a_number_is_not_called_a_constant", "F023", "", "const totals = [18000, 4000, 12000];", "let totals = 18000;", false, "valor inicial deve ser um array"},
+		// Seventh pass: satisfies is not a type assertion, and the message named one.
+		{"f021_satisfies_is_named_as_satisfies", "F021", "", expense, expense[:len(expense)-1] + " satisfies { id: string; total: number };", false, "satisfies"},
+		{"f023_satisfies_is_named_as_satisfies", "F023", "", "const totals = [18000, 4000, 12000];", "const totals = [18000, 4000, 12000] satisfies number[];", false, "satisfies"},
+		// 4. A deeply nested answer made the grader exit without a verdict.
+		{"f002_deeply_nested_parentheses", "F002", "", "18000", strings.Repeat("(", 1400) + "18000" + strings.Repeat(")", 1400), false, "encaixadas"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := check.grade(gradeJob{Family: tc.family, Mode: "code", Expected: tc.reference, ContextCode: tc.context, Answer: tc.answer})
+			if got.Unavailable || got.Correct != tc.correct || !strings.Contains(got.Feedback, tc.feedback) {
+				t.Fatalf("grade = %+v, want correct=%t with %q", got, tc.correct, tc.feedback)
+			}
+		})
+	}
+	// Seventh pass: a name or a symbol is compared as the compiler reads it, so a comment beside it
+	// does not change the answer.
+	tokens := []struct {
+		name, family, reference, answer string
+		correct                         bool
+		feedback                        string
+	}{
+		{"f005_token_with_block_comment", "F005", "number", "number /* tipo */", true, ""},
+		{"f006_token_after_line_comment", "F006", "string", "// o tipo textual\nstring", true, ""},
+		{"f012_symbol_with_comment", "F012", ":", ": /* dois-pontos */", true, ""},
+		{"f005_two_names_are_not_one", "F005", "number", "number string", false, "não é o nome"},
+		{"f005_name_in_capitals", "F005", "number", "Number // tipo", false, "Maiúsculas"},
+		{"f007_only_a_comment", "F007", "boolean", "/* boolean */", false, "não é o nome"},
+		// Eighth pass: a comment that is never closed is a syntax error, not a comment to ignore.
+		{"f005_token_with_unclosed_comment", "F005", "number", "number /* tipo", false, "erro de sintaxe"},
+		{"f012_symbol_with_unclosed_comment", "F012", ":", ": /* tipo", false, "erro de sintaxe"},
+		{"f006_token_with_unclosed_text", "F006", "string", "string \"", false, "erro de sintaxe"},
+	}
+	for _, tc := range tokens {
+		t.Run(tc.name, func(t *testing.T) {
+			got := check.grade(gradeJob{Family: tc.family, Mode: "token", Expected: tc.reference, Answer: tc.answer})
+			if got.Unavailable || got.Correct != tc.correct || !strings.Contains(got.Feedback, tc.feedback) {
+				t.Fatalf("grade = %+v, want correct=%t with %q", got, tc.correct, tc.feedback)
+			}
+		})
+	}
+}
