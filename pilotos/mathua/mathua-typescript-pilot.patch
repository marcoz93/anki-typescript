+// The engine resolves the letter of an alternative against the served question. A new concept of
+// the package is answered that way, and a miss leaves the learner a variant of the same family.
+func TestChoiceIsAnsweredByLetterThroughTheAPI(t *testing.T) {
+	t.Setenv("MATHUA_DEV_UNLOCK", "")
+	_, c := testContent(t)
+	e := boot(t, filepath.Join(t.TempDir(), "choice.db"), testChecker(t))
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	guest, _ := e.request(t, "POST", "/api/auth/guest", "", map[string]any{}, 200)
+	token := guest["token"].(string)
+	const concept = "ts.value.literal_notation"
+	first := e.question(t, token, concept)
+	letter := solve(t, concept, first)
+	wrong := "A"
+	if letter == "A" {
+		wrong = "B"
+	}
+	res, raw := e.request(t, "POST", "/api/study/answer", token, submission(concept, first, wrong, "choice-miss"), 200)
+	if res["correct"] != false || res["ungraded"] == true || res["explanation"] == "" {
+		t.Fatalf("wrong alternative: %s", raw)
+	}
+	next := e.question(t, token, concept, first)
+	firstFamily, firstCase, _ := c.lookup(concept, first)
+	nextFamily, nextCase, ok := c.lookup(concept, next)
+	if !ok || nextFamily != firstFamily || nextCase == firstCase {
+		t.Fatalf("variant after a miss: %s %s after %s %s", nextFamily, nextCase, firstFamily, firstCase)
+	}
+	res, raw = e.request(t, "POST", "/api/study/answer", token, submission(concept, next, strings.ToLower(solve(t, concept, next)), "choice-hit"), 200)
+	if res["correct"] != true || res["ungraded"] == true || strings.TrimSpace(res["expected_answer"].(string)) == "" {
+		t.Fatalf("lowercase letter of the correct alternative: %s", raw)
+	}
+	t.Logf("%s: missed %s with %s, then %s accepted by letter; reference shown: %s", firstFamily, firstCase, wrong, nextCase, res["expected_answer"])
+}
+
+// caseJob is the grader input the exercise builds for one served case: family, mode, reference
+// answer and context code. The caller fills in the answer.
+func caseJob(t *testing.T, caseID string) gradeJob {
+	t.Helper()
+	_, c := testContent(t)
+	for _, f := range c.families {
+		for _, k := range f.Cases {
+			if k.ID == caseID {
+				return gradeJob{Case: k.ID, Family: f.ID, Mode: f.Mode, Expected: expectedText(f, k), ContextCode: k.ContextCode}
+			}
+		}
+	}
+	t.Fatalf("case %s is not served", caseID)
+	return gradeJob{}
+}
+
+// criterion is one answer a learner could write for one served case, and the verdict the contract
+// asks for. says, when set, is a part the feedback must contain: a miss names a cause the answer has.
+type criterion struct {
+	name, caseID, answer string
+	correct              bool
+	says                 string
+}
+
+// judge grades the rows in batches, one grader process per batch, and checks each verdict.
+func judge(t *testing.T, check *checker, rows []criterion) {
+	t.Helper()
+	jobs := make([]gradeJob, len(rows))
+	for i, row := range rows {
+		jobs[i] = caseJob(t, row.caseID)
+		jobs[i].Answer = row.answer
+	}
+	verdicts := make([]grader.Result, 0, len(rows))
+	for start := 0; start < len(jobs); start += 25 {
+		end := min(start+25, len(jobs))
+		got, err := check.gradeBatch(jobs[start:end])
+		if err != nil {
+			t.Fatal(err)
+		}
+		verdicts = append(verdicts, got...)
+	}
+	for i, row := range rows {
+		got := verdicts[i]
+		t.Run(row.name, func(t *testing.T) {
+			if got.Unavailable || got.Correct != row.correct || got.Feedback == "" || !strings.Contains(got.Feedback, row.says) {
+				t.Fatalf("%s %q: grade = %+v, want correct=%t and feedback containing %q", row.caseID, row.answer, got, row.correct, row.says)
+			}
+		})
+	}
+}
