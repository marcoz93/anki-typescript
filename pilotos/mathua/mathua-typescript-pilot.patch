+func TestContentOfTheIntegratedStages(t *testing.T) {
+	dir, c := testContent(t)
+	cases, questions := 0, 0
+	for _, spec := range c.Concepts {
+		if len(spec.FamilyIDs) < 1 || len(spec.FamilyIDs) > maxFamiliesPerConcept {
+			t.Fatalf("%s has %d families", spec.ID, len(spec.FamilyIDs))
+		}
+		for _, f := range c.familiesOf(spec) {
+			for _, k := range f.Cases {
+				cases++
+				// A report stores the concept and the question. They must identify one instance.
+				if familyID, caseID, ok := c.lookup(spec.ID, questionText(k)); !ok || familyID != f.ID || caseID != k.ID {
+					t.Fatalf("%s: lookup returned %s %s %t", k.ID, familyID, caseID, ok)
+				}
+				questions++
+			}
+		}
+	}
+	if len(c.Concepts) != 23 || len(c.families) != 25 || cases != 150 {
+		t.Fatalf("stages 1 to %d: %d concepts, %d families, %d cases", integratedThroughStage, len(c.Concepts), len(c.families), cases)
+	}
+	// The three original concepts keep their IDs and the family the package assigns to them.
+	for id, want := range map[string]string{literalID: "F002", typeID: "F005", constID: "F010"} {
+		found := false
+		for _, spec := range c.Concepts {
+			if spec.ID == id {
+				found = len(spec.FamilyIDs) == 1 && spec.FamilyIDs[0] == want
+			}
+		}
+		if !found {
+			t.Fatalf("%s must be served by family %s alone", id, want)
+		}
+	}
+	// A stage beyond the integrated ones has no grader yet, so the self-check must refuse it.
+	next, err := loadContent(dir, integratedThroughStage+1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := next.verifyModelAnswers(testChecker(t)); err == nil || !strings.Contains(err.Error(), "No grader for family") {
+		t.Fatalf("stage %d must be refused until its graders exist, got %v", integratedThroughStage+1, err)
+	}
+	t.Logf("%s: %d concepts, %d families, %d cases, %d questions identified", c.Version, len(c.Concepts), len(c.families), cases, questions)
+}
