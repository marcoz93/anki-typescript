+++ b/cmd/typescript-pilot/content.go
@@ -0,0 +1,415 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+
+	"github.com/chuma-beep/mathua/internal/concepts"
+	"github.com/chuma-beep/mathua/internal/generator"
+	"github.com/chuma-beep/mathua/internal/grader"
+)
+
+// integratedThroughStage is the last ladder stage whose families have graders in grade.cjs.
+// Raising it serves more of the content package. Startup grades every model answer of the
+// served stages and refuses to run when a grader is missing or rejects its own model answer.
+const integratedThroughStage = 3
+
+// contentDirName is where the editorial package lives in the repository that carries this pilot.
+const contentDirName = "conteudo/typescript-v1"
+
+// maxFamiliesPerConcept follows the existing practice route, which accepts kp_ordinal 1 to 3.
+const maxFamiliesPerConcept = 3
+
+type choice struct {
+	ID   string `json:"id"`
+	Text string `json:"text"`
+}
+
+type exerciseCase struct {
+	ID                string   `json:"id"`
+	Prompt            string   `json:"prompt"`
+	ContextCode       string   `json:"context_code"`
+	Answer            string   `json:"answer"`
+	AnswerExplanation string   `json:"answer_explanation"`
+	Explanation       string   `json:"explanation"`
+	CodeForm          string   `json:"code_form"`
+	Choices           []choice `json:"choices"`
+}
+
+type family struct {
+	ID        string         `json:"id"`
+	ConceptID string         `json:"concept_id"`
+	Mode      string         `json:"mode"`
+	Cases     []exerciseCase `json:"cases"`
+}
+
+type conceptSpec struct {
+	ID            string   `json:"id"`
+	Label         string   `json:"label"`
+	Stage         int      `json:"stage"`
+	Prerequisites []string `json:"prerequisites"`
+	FamilyIDs     []string `json:"family_ids"`
+}
+
+// content is the served part of the editorial package: the concepts up to one stage.
+type content struct {
+	Version  string
+	Concepts []conceptSpec
+	families map[string]*family
+	lessons  map[int]string
+}
+
+// gradeJob is what grade.cjs needs to judge one answer. The learner's answer is filled in last.
+type gradeJob struct {
+	Case        string `json:"case"`
+	Family      string `json:"family"`
+	Mode        string `json:"mode"`
+	Expected    string `json:"expected"`
+	ContextCode string `json:"context_code"`
+	CodeForm    string `json:"code_form"`
+	Answer      string `json:"answer"`
+}
+
+// findContentDir walks up from start until it finds the editorial package.
+func findContentDir(start string) (string, error) {
+	dir, err := filepath.Abs(start)
+	if err != nil {
+		return "", err
+	}
+	for {
+		candidate := filepath.Join(dir, filepath.FromSlash(contentDirName))
+		if _, err := os.Stat(filepath.Join(candidate, "exercicios.json")); err == nil {
+			return candidate, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("content package %s not found above %s; pass -content", contentDirName, start)
+		}
+		dir = parent
+	}
+}
+
+func readJSON(path string, into any) error {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	if err := json.Unmarshal(raw, into); err != nil {
+		return fmt.Errorf("%s: %w", path, err)
+	}
+	return nil
+}
+
+// loadContent reads curriculo.json and exercicios.json and keeps the concepts up to throughStage.
+// It rejects content the existing engine cannot serve as written, instead of serving part of it.
+func loadContent(dir string, throughStage int) (*content, error) {
+	var curriculum struct {
+		Version string `json:"version"`
+		Stages  []struct {
+			Order          int    `json:"order"`
+			LessonMarkdown string `json:"lesson_markdown"`
+		} `json:"stages"`
+		Concepts []conceptSpec `json:"concepts"`
+	}
+	var exercises struct {
+		Version  string   `json:"version"`
+		Families []family `json:"families"`
+	}
+	if err := readJSON(filepath.Join(dir, "curriculo.json"), &curriculum); err != nil {
+		return nil, err
+	}
+	if err := readJSON(filepath.Join(dir, "exercicios.json"), &exercises); err != nil {
+		return nil, err
+	}
+	if curriculum.Version == "" || curriculum.Version != exercises.Version {
+		return nil, fmt.Errorf("content versions differ: curriculum %q, exercises %q", curriculum.Version, exercises.Version)
+	}
+	c := &content{Version: curriculum.Version, families: map[string]*family{}, lessons: map[int]string{}}
+	for _, s := range curriculum.Stages {
+		c.lessons[s.Order] = s.LessonMarkdown
+	}
+	all := map[string]*family{}
+	for i := range exercises.Families {
+		all[exercises.Families[i].ID] = &exercises.Families[i]
+	}
+	served := map[string]bool{}
+	for _, spec := range curriculum.Concepts {
+		if spec.Stage >= 1 && spec.Stage <= throughStage {
+			c.Concepts = append(c.Concepts, spec)
+			served[spec.ID] = true
+		}
+	}
+	if len(c.Concepts) == 0 {
+		return nil, fmt.Errorf("no concept in stages 1 to %d", throughStage)
+	}
+	for _, spec := range c.Concepts {
+		if strings.TrimSpace(c.lessons[spec.Stage]) == "" {
+			return nil, fmt.Errorf("%s: stage %d has no lesson", spec.ID, spec.Stage)
+		}
+		for _, pre := range spec.Prerequisites {
+			if !served[pre] {
+				return nil, fmt.Errorf("%s: prerequisite %s is outside stages 1 to %d", spec.ID, pre, throughStage)
+			}
+		}
+		if len(spec.FamilyIDs) == 0 || len(spec.FamilyIDs) > maxFamiliesPerConcept {
+			return nil, fmt.Errorf("%s: %d families; the practice route serves 1 to %d sections", spec.ID, len(spec.FamilyIDs), maxFamiliesPerConcept)
+		}
+		questions := map[string]string{}
+		for _, id := range spec.FamilyIDs {
+			f := all[id]
+			if f == nil || f.ConceptID != spec.ID || len(f.Cases) == 0 {
+				return nil, fmt.Errorf("%s: family %s is missing, empty or belongs to another concept", spec.ID, id)
+			}
+			for _, k := range f.Cases {
+				if strings.TrimSpace(k.Prompt) == "" || strings.TrimSpace(k.Answer) == "" || strings.TrimSpace(k.Explanation) == "" {
+					return nil, fmt.Errorf("%s: prompt, answer and explanation are required", k.ID)
+				}
+				if f.Mode == "choice" && choiceText(k, k.Answer) == "" {
+					return nil, fmt.Errorf("%s: answer %q is not one of its choices", k.ID, k.Answer)
+				}
+				q := questionText(k)
+				if other, dup := questions[q]; dup {
+					return nil, fmt.Errorf("%s and %s serve the same question in %s", other, k.ID, spec.ID)
+				}
+				questions[q] = k.ID
+			}
+			c.families[id] = f
+		}
+	}
+	return c, nil
+}
+
+func choiceText(k exerciseCase, id string) string {
+	for _, option := range k.Choices {
+		if option.ID == id {
+			return option.Text
+		}
+	}
+	return ""
+}
+
+// questionText is the text served to the learner and stored with each attempt and report.
+// Choices use the "A) text" blocks the existing interface already turns into buttons.
+func questionText(k exerciseCase) string {
+	var b strings.Builder
+	b.WriteString(strings.TrimSpace(k.Prompt))
+	if code := strings.TrimSpace(k.ContextCode); code != "" {
+		b.WriteString("\n\n```ts\n" + code + "\n```")
+	}
+	for _, option := range k.Choices {
+		b.WriteString("\n\n" + option.ID + ") " + strings.TrimSpace(option.Text))
+	}
+	return b.String()
+}
+
+// expectedText is the reference answer shown after grading. The engine hands it back to Grade.
+// For a choice it is the text of the correct alternative: the engine resolves the letter a learner
+// taps or types to the text of that alternative in the served question before it grades.
+func expectedText(f *family, k exerciseCase) string {
+	if f.Mode == "choice" {
+		return strings.TrimSpace(choiceText(k, k.Answer))
+	}
+	return k.Answer
+}
+
+func (c *content) familiesOf(spec conceptSpec) []*family {
+	list := make([]*family, 0, len(spec.FamilyIDs))
+	for _, id := range spec.FamilyIDs {
+		list = append(list, c.families[id])
+	}
+	return list
+}
+
+// lookup returns the family and case that serve a question of a concept. A report stores the
+// concept and the question, so this recovers the instance under review without new storage.
+func (c *content) lookup(conceptID, question string) (familyID, caseID string, ok bool) {
+	for _, spec := range c.Concepts {
+		if spec.ID != conceptID {
+			continue
+		}
+		for _, f := range c.familiesOf(spec) {
+			for _, k := range f.Cases {
+				if questionText(k) == question {
+					return f.ID, k.ID, true
+				}
+			}
+		}
+	}
+	return "", "", false
+}
+
+// exercise serves one concept. Each family is one section of the lesson (a knowledge point),
+// so the existing stepper keeps a learner on the same family after a wrong answer.
+type exercise struct {
+	families []*family
+	check    *checker
+	draw     atomic.Int64
+	jobs     map[string]gradeJob
+	hint     string
+}
+
+func newExercise(spec conceptSpec, families []*family, check *checker) (*exercise, error) {
+	g := &exercise{families: families, check: check, jobs: map[string]gradeJob{}, hint: "Selecione uma alternativa ou digite a letra dela."}
+	for _, f := range families {
+		if f.Mode != "choice" {
+			g.hint = "Digite somente a resposta solicitada, sem bloco Markdown."
+		}
+		for _, k := range f.Cases {
+			key := expectedText(f, k)
+			job := gradeJob{Case: k.ID, Family: f.ID, Mode: f.Mode, Expected: key, ContextCode: k.ContextCode, CodeForm: k.CodeForm}
+			// The engine gives Grade only the reference answer. Two cases may share it only when
+			// the grader would receive the same task for both. A choice is judged by its text alone.
+			if other, seen := g.jobs[key]; seen {
+				sameTask := other.Mode == job.Mode && (job.Mode == "choice" || other.Family == job.Family) &&
+					(job.Mode != "code" || other.ContextCode == job.ContextCode)
+				if !sameTask {
+					return nil, fmt.Errorf("%s: cases %s and %s share the reference answer %q with different tasks", spec.ID, other.Case, k.ID, key)
+				}
+				continue
+			}
+			g.jobs[key] = job
+		}
+	}
+	return g, nil
+}
+
+func (g *exercise) Generate(ctx generator.GeneratorContext) generator.Problem {
+	// Mathua calls Generate repeatedly with one context in a batch. The local counter walks the
+	// finite bank, so every case of the section is reached before one repeats.
+	n := uint64(ctx.Seed) + uint64(g.draw.Add(1))
+	var f *family
+	var k exerciseCase
+	if ctx.KPOrdinal >= 1 && ctx.KPOrdinal <= len(g.families) {
+		f = g.families[ctx.KPOrdinal-1]
+		k = f.Cases[n%uint64(len(f.Cases))]
+	} else {
+		total := 0
+		for _, each := range g.families {
+			total += len(each.Cases)
+		}
+		at := int(n % uint64(total))
+		for _, each := range g.families {
+			if at < len(each.Cases) {
+				f, k = each, each.Cases[at]
+				break
+			}
+			at -= len(each.Cases)
+		}
+	}
+	return generator.Problem{Question: questionText(k), Answer: expectedText(f, k), Explanation: k.Explanation}
+}
+
+func (g *exercise) Grade(expected, answer string) grader.Result {
+	job, ok := g.jobs[expected]
+	if !ok {
+		return grader.Result{Unavailable: true, Feedback: "Esta pergunta não pertence à versão atual do conteúdo. Sua resposta não foi contada como erro."}
+	}
+	job.Answer = answer
+	return g.check.grade(job)
+}
+
+func (g *exercise) AnswerFormat() generator.AnswerFormat {
+	return generator.AnswerFormat{InputMode: "text", Hint: g.hint}
+}
+
+// gradingTypes keeps the values the three original pilot concepts were registered with.
+var gradingTypes = map[string]string{"ts.value.numeric_literal": "numeric"}
+
+func (c *content) dag() (*concepts.DAG, error) {
+	list := make([]concepts.Concept, 0, len(c.Concepts))
+	for _, spec := range c.Concepts {
+		gradingType := gradingTypes[spec.ID]
+		if gradingType == "" {
+			gradingType = "expression"
+		}
+		// The prerequisite edges are the package's teaching choice, and the thresholds are the
+		// ones the pilot already used. This integration adds no new statistical threshold.
+		list = append(list, concepts.Concept{ID: spec.ID, Label: spec.Label, Domain: "typescript", GradingType: gradingType,
+			Prerequisites: spec.Prerequisites, MasteryThreshold: concepts.MasteryThreshold{Streak: 3, AvgTimeSeconds: 60}})
+	}
+	return concepts.Build(list)
+}
+
+func sectionLabel(spec conceptSpec, index int) string {
+	if len(spec.FamilyIDs) == 1 {
+		return spec.Label
+	}
+	return fmt.Sprintf("%s (parte %d de %d)", spec.Label, index+1, len(spec.FamilyIDs))
+}
+
+// writeLessons writes the files the existing lesson loader reads. The package has one lesson per
+// stage, so every concept of a stage shows that lesson, once per section.
+func (c *content) writeLessons(dir string) error {
+	if err := os.MkdirAll(filepath.Join(dir, "kp"), 0o755); err != nil {
+		return err
+	}
+	type entry struct {
+		ConceptID string `json:"concept_id"`
+		Source    string `json:"source"`
+	}
+	type point struct {
+		Label    string   `json:"label"`
+		Section  string   `json:"section"`
+		Subgoals []string `json:"subgoals"`
+	}
+	index := make([]entry, 0, len(c.Concepts))
+	for _, spec := range c.Concepts {
+		var md strings.Builder
+		md.WriteString("# " + spec.Label + "\n")
+		points := make([]point, 0, len(spec.FamilyIDs))
+		for i := range spec.FamilyIDs {
+			label := sectionLabel(spec, i)
+			md.WriteString("\n## " + label + "\n\n" + strings.TrimSpace(c.lessons[spec.Stage]) + "\n")
+			points = append(points, point{Label: label, Section: label, Subgoals: []string{}})
+		}
+		if err := os.WriteFile(filepath.Join(dir, spec.ID+".md"), []byte(md.String()), 0o644); err != nil {
+			return err
+		}
+		raw, err := json.Marshal(points)
+		if err != nil {
+			return err
+		}
+		if err := os.WriteFile(filepath.Join(dir, "kp", spec.ID+".json"), raw, 0o644); err != nil {
+			return err
+		}
+		index = append(index, entry{ConceptID: spec.ID, Source: spec.ID + ".md"})
+	}
+	raw, err := json.Marshal(index)
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(dir, "lessons.json"), raw, 0o644)
+}
+
+// verifyModelAnswers grades every served case with its own model answer in one grader process.
+// A missing grader, a broken context or a model answer its grader rejects stops the start.
+func (c *content) verifyModelAnswers(check *checker) error {
+	var jobs []gradeJob
+	for _, spec := range c.Concepts {
+		for _, f := range c.familiesOf(spec) {
+			for _, k := range f.Cases {
+				reference := expectedText(f, k)
+				jobs = append(jobs, gradeJob{Case: k.ID, Family: f.ID, Mode: f.Mode, Expected: reference,
+					ContextCode: k.ContextCode, CodeForm: k.CodeForm, Answer: reference})
+			}
+		}
+	}
+	results, err := check.gradeBatch(jobs)
+	if err != nil {
+		return fmt.Errorf("content self-check could not run: %w", err)
+	}
+	var failed []string
+	for i, result := range results {
+		if result.Unavailable || !result.Correct {
+			failed = append(failed, fmt.Sprintf("%s (%s)", jobs[i].Case, result.Feedback))
+		}
+	}
+	if len(failed) > 0 {
+		return fmt.Errorf("%d of %d model answers are not accepted by their grader: %s", len(failed), len(jobs), strings.Join(failed, "; "))
+	}
+	return nil
+}
diff --git a/cmd/typescript-pilot/grade.cjs b/cmd/typescript-pilot/grade.cjs
new file mode 100644
index 00000000..e020646f
--- /dev/null
+++ b/cmd/typescript-pilot/grade.cjs
@@ -0,0 +1,181 @@
+'use strict';
+
+// This is a narrow static grader. Learner code is never evaluated or emitted.
+// Each job names the family of the editorial package it belongs to. A family without a grader
+// here is an error, never a wrong answer: the caller reports it as "not graded".
+const ts = require('typescript');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const result = (correct, feedback) => ({correct, score: correct ? 1 : 0, feedback});
+const parse = source => ts.createSourceFile('answer.ts', source, ts.ScriptTarget.ES2022, true);
+
+function typeErrors(source) {
+  const filename = path.resolve(__dirname, '__answer__.ts');
+  const options = {strict: true, noEmit: true, types: [], skipLibCheck: true, target: ts.ScriptTarget.ES2022};
+  const host = ts.createCompilerHost(options);
+  const library = path.dirname(ts.getDefaultLibFilePath(options));
+  const read = host.readFile.bind(host);
+  // Only compiler library files are accessible. Triple-slash paths in an answer
+  // cannot make the checker read other project or host files.
+  const allowed = file => path.dirname(path.resolve(file)) === library && /^lib(?:\..+)?\.d\.ts$/.test(path.basename(file));
+  host.readFile = file => path.resolve(file) === filename ? source : allowed(file) ? read(file) : undefined;
+  host.fileExists = file => path.resolve(file) === filename || (allowed(file) && ts.sys.fileExists(file));
+  host.getSourceFile = (file, languageVersion) => {
+    const content = host.readFile(file);
+    return content === undefined ? undefined : ts.createSourceFile(file, content, languageVersion, true);
+  };
+  const program = ts.createProgram([filename], options, host);
+  return ts.getPreEmitDiagnostics(program).map(d => ts.flattenDiagnosticMessageText(d.messageText, '\n'));
+}
+
+// The single expression of an answer such as `15000` or `"reembolso-01";`, or null.
+function onlyExpression(sf) {
+  const statement = sf.statements.length === 1 && sf.statements[0];
+  return statement && ts.isExpressionStatement(statement) ? statement.expression : null;
+}
+
+// The single `name = initializer` of an answer made of one variable statement, or null.
+function declaration(sf) {
+  const statement = sf.statements.length === 1 && sf.statements[0];
+  if (!statement || !ts.isVariableStatement(statement) || statement.modifiers?.length) return null;
+  const list = statement.declarationList;
+  if (list.declarations.length !== 1) return null;
+  return {list, item: list.declarations[0]};
+}
+
+// Single and double quotes write the same text. A template literal is a different notation.
+const isQuotedText = node => !!node && ts.isStringLiteral(node);
+const isBooleanLiteral = node => !!node && (node.kind === ts.SyntaxKind.TrueKeyword || node.kind === ts.SyntaxKind.FalseKeyword);
+
+function parsedAnswer(answer) {
+  const sf = parse(answer);
+  return sf.parseDiagnostics.length ? null : sf;
+}
+
+const SYNTAX = 'A resposta contém um erro de sintaxe TypeScript.';
+
+// F002: one numeric literal of the requested value. Separators are valid; text and sums are not.
+function numericLiteral({expected, answer}) {
+  const sf = parsedAnswer(answer);
+  if (!sf) return result(false, SYNTAX);
+  const expr = onlyExpression(sf);
+  if (!expr || !ts.isNumericLiteral(expr)) return result(false, 'Use somente um literal numérico, sem aspas e sem operações.');
+  if (Number(expr.text) !== Number(expected)) return result(false, 'O literal representa um valor diferente do solicitado.');
+  return result(true, 'Correto. O literal representa o valor solicitado.');
+}
+
+// F003: one text literal with the exact content, in single or double quotes.
+function stringLiteral({expected, answer}) {
+  const reference = onlyExpression(parse(expected));
+  if (!isQuotedText(reference)) throw new Error('Invalid reference text literal');
+  const sf = parsedAnswer(answer);
+  if (!sf) return result(false, SYNTAX);
+  const expr = onlyExpression(sf);
+  if (!isQuotedText(expr)) return result(false, 'Use somente um literal textual, entre aspas simples ou duplas.');
+  if (expr.text !== reference.text) return result(false, 'O texto entre aspas difere do conteúdo solicitado.');
+  return result(true, 'Correto. O literal representa o texto solicitado.');
+}
+
+// F004: the requested boolean literal, unquoted.
+function booleanLiteral({expected, answer}) {
+  if (expected !== 'true' && expected !== 'false') throw new Error('Invalid reference boolean literal');
+  const sf = parsedAnswer(answer);
+  if (!sf) return result(false, SYNTAX);
+  const expr = onlyExpression(sf);
+  if (!isBooleanLiteral(expr)) return result(false, 'Use somente um literal booleano, true ou false, sem aspas.');
+  if (expr.getText(sf) !== expected) return result(false, 'O literal booleano tem o valor oposto ao solicitado.');
+  return result(true, 'Correto. O literal booleano representa o valor solicitado.');
+}
+
+// F010 and F011: one const declaration with the requested name and literal value.
+// The type annotation is optional and, when present, must be the type of that value.
+function constDeclaration(job, kind) {
+  const isValue = kind === 'number' ? ts.isNumericLiteral : isQuotedText;
+  const sameValue = kind === 'number' ? (a, b) => Number(a.text) === Number(b.text) : (a, b) => a.text === b.text;
+  const keyword = kind === 'number' ? ts.SyntaxKind.NumberKeyword : ts.SyntaxKind.StringKeyword;
+  const literalName = kind === 'number' ? 'um literal numérico, sem aspas e sem operações' : 'um literal textual, entre aspas simples ou duplas';
+  const reference = declaration(parse(job.expected));
+  if (!reference || !ts.isIdentifier(reference.item.name) || !reference.item.initializer || !isValue(reference.item.initializer)) {
+    throw new Error('Invalid reference declaration');
+  }
+  const sf = parsedAnswer(job.answer);
+  if (!sf) return result(false, SYNTAX);
+  const actual = declaration(sf);
+  if (!actual) return result(false, 'Escreva somente uma declaração de constante, com um único nome.');
+  if (!(actual.list.flags & ts.NodeFlags.Const)) return result(false, 'A tarefa pede const, que impede reatribuir esse nome após a inicialização. let permite reatribuição.');
+  if (!ts.isIdentifier(actual.item.name) || actual.item.name.text !== reference.item.name.text) {
+    return result(false, `Use o nome solicitado: ${reference.item.name.text}.`);
+  }
+  const init = actual.item.initializer;
+  if (!init || !isValue(init)) return result(false, `Inicialize a constante com ${literalName}.`);
+  if (!sameValue(init, reference.item.initializer)) return result(false, 'O valor inicial difere do solicitado.');
+  if (actual.item.type && actual.item.type.kind !== keyword) {
+    return result(false, `Neste exercício, omita a anotação ou use ${kind}.`);
+  }
+  const errors = typeErrors(job.answer);
+  if (errors.length) return result(false, `O compilador TypeScript rejeitou a declaração: ${errors[0]}`);
+  return result(true, `Correto. A constante tem o nome e o valor solicitados. A anotação ${kind} é opcional neste exercício.`);
+}
+
+const CODE = {
+  F002: numericLiteral,
+  F003: stringLiteral,
+  F004: booleanLiteral,
+  F010: job => constDeclaration(job, 'number'),
+  F011: job => constDeclaration(job, 'string'),
+};
+
+// A choice arrives as the text of one alternative: the engine resolves the letter a learner taps
+// or types against the served question before it grades. The verdict names no cause for a miss.
+function choice({expected, answer}) {
+  if (!expected.trim()) throw new Error('Invalid reference alternative');
+  return answer.trim() === expected.trim()
+    ? result(true, 'Correto.')
+    : result(false, 'Esta não é a alternativa correta.');
+}
+
+// A token is a name, a type or a symbol of the language. Case is part of it.
+function token({expected, answer}) {
+  const given = answer.trim();
+  if (given === expected) return result(true, 'Correto.');
+  if (given.toLowerCase() === expected.toLowerCase()) {
+    return result(false, `Maiúsculas e minúsculas fazem diferença: ${given} não é o mesmo que ${expected}.`);
+  }
+  return result(false, 'A resposta não é o nome ou o símbolo solicitado.');
+}
+
+function grade(job) {
+  const {family, mode, expected, answer} = job;
+  if (typeof expected !== 'string' || typeof answer !== 'string') throw new Error('Invalid grader input');
+  if (!answer.trim()) return result(false, 'Digite a resposta solicitada.');
+  if (answer.length > 4096) return result(false, 'A resposta excede o tamanho deste exercício.');
+  if (mode === 'choice') return choice(job);
+  if (mode === 'token') return token(job);
+  if (mode === 'code' && Object.hasOwn(CODE, family)) return CODE[family](job);
+  throw new Error(`No grader for family ${family} (${mode})`);
+}
+
+// One verdict per job. A job that cannot be judged yields {error}, apart from a wrong answer.
+function gradeAll(jobs) {
+  return jobs.map(job => {
+    try {
+      return grade(job);
+    } catch (error) {
+      return {error: error.message};
+    }
+  });
+}
+
+if (require.main === module) {
+  try {
+    const input = JSON.parse(fs.readFileSync(0, 'utf8'));
+    const output = Array.isArray(input.batch) ? {results: gradeAll(input.batch)} : grade(input);
+    process.stdout.write(JSON.stringify(output));
+  } catch (error) {
+    process.stderr.write(error.message + '\n');
+    process.exitCode = 1;
+  }
+}
+
+module.exports = {grade, gradeAll};
diff --git a/cmd/typescript-pilot/main.go b/cmd/typescript-pilot/main.go
new file mode 100644
index 00000000..f75ee4b0
--- /dev/null
+++ b/cmd/typescript-pilot/main.go
@@ -0,0 +1,212 @@
+// This pilot composes Mathua's existing engine and HTTP API with TypeScript exercises.
+// The exercises, lessons and prerequisite edges come from the editorial package; see content.go.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/chuma-beep/mathua/internal/auth"
+	"github.com/chuma-beep/mathua/internal/engine"
+	"github.com/chuma-beep/mathua/internal/generator"
+	"github.com/chuma-beep/mathua/internal/grader"
+	"github.com/chuma-beep/mathua/internal/lessons"
+	"github.com/chuma-beep/mathua/internal/server"
+	"github.com/chuma-beep/mathua/internal/storage"
+)
+
+// The three concepts of the first pilot keep their IDs, so their stored progress stays valid.
+const (
+	literalID = "ts.value.numeric_literal"
+	typeID    = "ts.type.number"
+	constID   = "ts.binding.const_number"
+)
+
+// checker parses and typechecks learner input. It never executes that input.
+type checker struct {
+	node   string
+	script string
+}
+
+// graded is one verdict from grade.cjs. Error is set when a job could not be judged at all.
+type graded struct {
+	Correct  bool    `json:"correct"`
+	Score    float64 `json:"score"`
+	Feedback string  `json:"feedback"`
+	Error    string  `json:"error"`
+}
+
+const graderUnavailable = "O corretor TypeScript está indisponível. Sua resposta não foi contada como erro."
+
+func (g graded) result() grader.Result {
+	if g.Error != "" {
+		return grader.Result{Unavailable: true, Feedback: g.Error}
+	}
+	if g.Feedback == "" {
+		return grader.Result{Unavailable: true, Feedback: graderUnavailable}
+	}
+	return grader.Result{Correct: g.Correct, Score: g.Score, Feedback: g.Feedback}
+}
+
+func (c *checker) run(timeout time.Duration, input, output any) error {
+	raw, err := json.Marshal(input)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, c.node, "--max-old-space-size=256", c.script)
+	cmd.Stdin = bytes.NewReader(raw)
+	out, err := cmd.Output()
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(out, output)
+}
+
+// grade judges one answer. Any failure to obtain a verdict is reported as unavailable, which the
+// engine keeps apart from a wrong answer: nothing is recorded and the learner can retry.
+func (c *checker) grade(job gradeJob) grader.Result {
+	var verdict graded
+	if err := c.run(10*time.Second, job, &verdict); err != nil || verdict.Error != "" {
+		return grader.Result{Unavailable: true, Feedback: graderUnavailable}
+	}
+	return verdict.result()
+}
+
+func (c *checker) gradeBatch(jobs []gradeJob) ([]grader.Result, error) {
+	var out struct {
+		Results []graded `json:"results"`
+	}
+	if err := c.run(60*time.Second, map[string]any{"batch": jobs}, &out); err != nil {
+		return nil, err
+	}
+	if len(out.Results) != len(jobs) {
+		return nil, fmt.Errorf("grader returned %d verdicts for %d jobs", len(out.Results), len(jobs))
+	}
+	results := make([]grader.Result, len(jobs))
+	for i, verdict := range out.Results {
+		results[i] = verdict.result()
+	}
+	return results, nil
+}
+
+// newPilot loads the content package from contentDir and writes the lesson files into lessonsDir.
+func newPilot(repo storage.Repository, check *checker, contentDir, lessonsDir string) (*http.ServeMux, *engine.Engine, *content, error) {
+	c, err := loadContent(contentDir, integratedThroughStage)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	dag, err := c.dag()
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	reg := generator.NewRegistry()
+	for _, spec := range c.Concepts {
+		item, err := newExercise(spec, c.familiesOf(spec), check)
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		if err := reg.Register(spec.ID, item); err != nil {
+			return nil, nil, nil, err
+		}
+	}
+	if err := c.verifyModelAnswers(check); err != nil {
+		return nil, nil, nil, err
+	}
+	if err := c.writeLessons(lessonsDir); err != nil {
+		return nil, nil, nil, err
+	}
+	ll, err := lessons.Load(lessonsDir)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	eng := engine.New(repo, dag, reg, ll, nil)
+	mux := http.NewServeMux()
+	server.New(eng, repo, auth.New(repo)).Register(mux)
+	return mux, eng, c, nil
+}
+
+// Serve the existing Next.js export beside the API. Its client uses the same origin.
+func studyFrontend(root, firstConcept string) http.Handler {
+	files := http.FileServer(http.Dir(root))
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/" {
+			http.Redirect(w, r, "/learn?concept="+firstConcept, http.StatusFound)
+			return
+		}
+		clean := path.Clean(r.URL.Path)
+		if path.Ext(clean) == "" {
+			htmlPath := strings.TrimSuffix(clean, "/") + ".html"
+			if info, err := os.Stat(filepath.Join(root, filepath.FromSlash(htmlPath))); err == nil && !info.IsDir() {
+				r.URL.Path = htmlPath
+			}
+		}
+		files.ServeHTTP(w, r)
+	})
+}
+
+func main() {
+	addr := flag.String("addr", "127.0.0.1:8081", "HTTP listen address")
+	db := flag.String("db", "typescript-pilot.db", "SQLite database path")
+	node := flag.String("node", "node", "Node executable")
+	script := flag.String("grader", "cmd/typescript-pilot/grade.cjs", "TypeScript grader path")
+	web := flag.String("web", "web/next-app/out", "Existing Next.js static export directory")
+	contentFlag := flag.String("content", "", "Editorial content directory; default: "+contentDirName+" found above the working directory")
+	flag.Parse()
+	resolvedNode, err := exec.LookPath(*node)
+	if err != nil {
+		log.Fatal(err)
+	}
+	resolvedScript, err := filepath.Abs(*script)
+	if err != nil {
+		log.Fatal(err)
+	}
+	contentDir := *contentFlag
+	if contentDir == "" {
+		if contentDir, err = findContentDir("."); err != nil {
+			log.Fatal(err)
+		}
+	}
+	// The lesson files are derived from the content package on every start.
+	lessonsDir := *db + ".lessons"
+	if err := os.RemoveAll(lessonsDir); err != nil {
+		log.Fatal(err)
+	}
+	repo, err := storage.NewSQLiteStore(*db)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer repo.Close()
+	auth.SetSecretFile(*db + ".jwt")
+	mux, _, c, err := newPilot(repo, &checker{node: resolvedNode, script: resolvedScript}, contentDir, lessonsDir)
+	if err != nil {
+		log.Fatal(err)
+	}
+	cases := 0
+	for _, f := range c.families {
+		cases += len(f.Cases)
+	}
+	log.Printf("Content %s from %s: stages 1 to %d, %d concepts, %d families, %d cases, every model answer accepted by its grader",
+		c.Version, contentDir, integratedThroughStage, len(c.Concepts), len(c.families), cases)
+	if info, err := os.Stat(filepath.Join(*web, "learn.html")); err == nil && !info.IsDir() {
+		mux.Handle("/", studyFrontend(*web, c.Concepts[0].ID))
+		log.Printf("Study interface: http://%s", *addr)
+	} else {
+		log.Print("Study interface not built. Run NEXT_PUBLIC_TS_PILOT=1 NEXT_PUBLIC_SAME_ORIGIN_API=1 npm run build in web/next-app.")
+	}
+	log.Printf("TypeScript pilot API: http://%s", *addr)
+	srv := &http.Server{Addr: *addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	log.Fatal(srv.ListenAndServe())
+}
diff --git a/cmd/typescript-pilot/main_test.go b/cmd/typescript-pilot/main_test.go
