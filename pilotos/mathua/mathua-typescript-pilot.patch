+    if (!sameLiteral(property.initializer, wanted.get(key))) return result(false, `A propriedade ${key} não tem o valor solicitado.`);
+  }
+  if (seen.size !== wanted.size) return result(false, `O objeto deve ter exatamente as propriedades ${names}.`);
+  return rejectedByCompiler(job, job.answer) || result(true, 'Correto. O objeto tem as propriedades e os valores solicitados.');
+}
+
+// F023: a const array with the requested elements, in the requested order.
+function arrayDeclaration(job) {
+  const reference = declaration(parse(job.expected));
+  const list = reference && reference.item.initializer;
+  if (!reference || !ts.isIdentifier(reference.item.name) || !list || !ts.isArrayLiteralExpression(list) || !list.elements.every(isLiteral)) {
+    throw new Error('Invalid reference array');
+  }
+  // The criterion of this family is the array, its name and the order of its elements. It does not
+  // name `const`, so `let` declares the requested array as well.
+  const given = constAnswer(job, reference.item.name.text, false);
+  if (given.fail) return given.fail;
+  if (wrapperOf(given.init)) return result(false, `Escreva o array diretamente, ${wrapperOf(given.init)}.`);
+  if (!given.init || !ts.isArrayLiteralExpression(given.init)) return result(false, 'O valor inicial deve ser um array, entre colchetes, com os elementos pedidos.');
+  const elements = given.init.elements;
+  if (elements.length !== list.elements.length || !elements.every(isLiteral)) return result(false, `O array deve ter exatamente ${list.elements.length} elementos, escritos como literais.`);
+  if (!elements.every((element, index) => sameLiteral(element, list.elements[index]))) {
+    // Another order only when every requested element appears as many times as requested.
+    // `[15000, 15000, 10000]` repeats one element and lacks another; that is not a reordering.
+    const left = [...list.elements];
+    const reordered = elements.every(element => {
+      const at = left.findIndex(other => sameLiteral(element, other));
+      return at >= 0 && left.splice(at, 1).length === 1;
+    });
+    return result(false, reordered ? 'Os elementos estão em outra ordem. A ordem pedida faz parte do resultado.' : 'O array tem um elemento diferente do solicitado.');
+  }
+  return rejectedByCompiler(job, job.answer) || result(true, 'Correto. O array tem os elementos solicitados, na ordem pedida.');
+}
+
+// F022: `object.property`, or `object["property"]` with the same key.
+function propertyAccess(job) {
+  const ref = referenceExpression(job.expected);
+  if (!ref || !ts.isPropertyAccessExpression(ref) || !ts.isIdentifier(ref.expression)) throw new Error('Invalid reference property access');
+  const given = expressionAnswer(job.answer);
+  if (given.fail) return given.fail;
+  let owner = null, key = null;
+  if (ts.isPropertyAccessExpression(given.expr) && !given.expr.questionDotToken) {
+    owner = unwrap(given.expr.expression);
+    key = given.expr.name.text;
+  } else if (ts.isElementAccessExpression(given.expr) && !given.expr.questionDotToken && isTextKey(unwrap(given.expr.argumentExpression))) {
+    owner = unwrap(given.expr.expression);
+    key = unwrap(given.expr.argumentExpression).text;
+  }
+  if (key === null) return result(false, `Escreva o acesso à propriedade ${ref.name.text}, com ponto ou com colchetes e o nome entre aspas.`);
+  if (!ts.isIdentifier(owner) || owner.text !== ref.expression.text) return result(false, `Acesse a propriedade no objeto ${ref.expression.text}.`);
+  if (key !== ref.name.text) return result(false, `A expressão acessa a propriedade ${key}. A tarefa pede ${ref.name.text}.`);
+  return rejectedByCompiler(job, `(${given.text});`) || result(true, `Correto. A expressão obtém a propriedade ${ref.name.text}.`);
+}
+
+const CODE = {
+  F002: numericLiteral,
+  F003: stringLiteral,
+  F004: booleanLiteral,
+  F010: job => constDeclaration(job, 'number'),
+  F011: job => constDeclaration(job, 'string'),
+  F016: greaterThan,
+  F018: strictEquality,
+  F019: booleanAnd,
+  F020: booleanNot,
+  F021: objectDeclaration,
+  F022: propertyAccess,
+  F023: arrayDeclaration,
+};
+
+// A value is the result a question asks the learner to read off: a number, a boolean, the absence
+// `undefined`, a text label or an array of those. It is written in TypeScript notation and never
+// computed here. An arbitrary expression is not a value.
+function value({expected, answer}) {
+  const ref = referenceExpression(expected);
+  if (!ref) throw new Error('Invalid reference value');
+  const given = expressionAnswer(answer);
+  const node = given.fail ? null : given.expr;
+  if (isBooleanLiteral(ref)) {
+    if (!node || !isBooleanLiteral(node)) return result(false, 'Responda com o valor booleano produzido: true ou false, sem aspas.');
+    return node.kind === ref.kind ? result(true, 'Correto.') : result(false, 'A expressão produz o outro valor booleano.');
+  }
+  if (ts.isNumericLiteral(ref)) {
+    if (!node || !ts.isNumericLiteral(node)) return result(false, 'Responda com o número obtido, sem aspas e sem operações.');
+    return Number(node.text) === Number(ref.text) ? result(true, 'Correto.') : result(false, 'O número obtido é outro.');
+  }
+  throw new Error('No value grader for this kind of result');
+}
+
+// A choice arrives as the text of one alternative: the engine resolves the letter a learner taps
+// or types against the served question before it grades. The verdict names no cause for a miss.
+function choice({expected, answer}) {
+  if (!expected.trim()) throw new Error('Invalid reference alternative');
+  return answer.trim() === expected.trim()
+    ? result(true, 'Correto.')
+    : result(false, 'Esta não é a alternativa correta.');
+}
+
+// A token is a name, a type or a symbol of the language. Case is part of it.
+// The tokens of a text as the compiler's scanner reads them: spaces and comments are not tokens.
+// `broken` is true when the scanner reports an error, such as a comment that is never closed.
+function tokensOf(text) {
+  let broken = false;
+  const scanner = ts.createScanner(ts.ScriptTarget.ES2022, true, ts.LanguageVariant.Standard, text, () => { broken = true; });
+  const found = [];
+  for (let kind = scanner.scan(); kind !== ts.SyntaxKind.EndOfFileToken && found.length < 64; kind = scanner.scan()) {
+    if (kind === ts.SyntaxKind.Unknown) broken = true;
+    found.push(scanner.getTokenText());
+  }
+  return {text: found.join(' '), broken};
+}
+
+function token({expected, answer}) {
+  const reference = tokensOf(expected);
+  if (reference.broken || !reference.text) throw new Error('Invalid reference token');
+  const scanned = tokensOf(answer);
+  if (scanned.broken) return result(false, SYNTAX);
+  const wanted = reference.text;
+  const given = scanned.text;
+  if (given === wanted) return result(true, 'Correto.');
+  if (given.toLowerCase() === wanted.toLowerCase()) {
+    return result(false, `Maiúsculas e minúsculas fazem diferença: ${given} não é o mesmo que ${wanted}.`);
+  }
+  return result(false, 'A resposta não é o nome ou o símbolo solicitado.');
+}
+
+function grade(job) {
+  const {family, mode, expected, answer} = job;
+  if (typeof expected !== 'string' || typeof answer !== 'string') throw new Error('Invalid grader input');
+  if (!answer.trim()) return result(false, 'Digite a resposta solicitada.');
+  if (answer.length > 4096) return result(false, 'A resposta excede o tamanho deste exercício.');
+  if (mode === 'choice') return choice(job);
+  if (mode === 'token') return token(job);
+  if (mode !== 'value' && !(mode === 'code' && Object.hasOwn(CODE, family))) throw new Error(`No grader for family ${family} (${mode})`);
+  try {
+    // A triple-slash directive changes what the compiler loads. It is never part of a requested answer.
+    if (hasDirective(answer)) {
+      return result(false, 'Remova a diretiva /// <reference>. A resposta deve conter somente o que a tarefa pede.');
+    }
+    return mode === 'value' ? value(job) : CODE[family](job);
+  } catch (error) {
+    // An answer nested too deeply for the parser is the learner's answer, not a grader outage.
+    if (error instanceof RangeError) return result(false, 'A resposta tem parênteses ou expressões encaixadas demais para este exercício.');
+    throw error;
+  }
+}
+
+// One verdict per job. A job that cannot be judged yields {error}, apart from a wrong answer.
+function gradeAll(jobs) {
+  return jobs.map(job => {
+    try {
+      return grade(job);
+    } catch (error) {
+      return {error: error.message};
+    }
+  });
+}
+
+if (require.main === module) {
+  try {
+    const input = JSON.parse(fs.readFileSync(0, 'utf8'));
+    const output = Array.isArray(input.batch) ? {results: gradeAll(input.batch)} : grade(input);
+    process.stdout.write(JSON.stringify(output));
+  } catch (error) {
+    process.stderr.write(error.message + '\n');
+    process.exitCode = 1;
+  }
+}
+
+module.exports = {grade, gradeAll};
diff --git a/cmd/typescript-pilot/main.go b/cmd/typescript-pilot/main.go
new file mode 100644
index 00000000..f75ee4b0
--- /dev/null
+++ b/cmd/typescript-pilot/main.go
@@ -0,0 +1,212 @@
+// This pilot composes Mathua's existing engine and HTTP API with TypeScript exercises.
+// The exercises, lessons and prerequisite edges come from the editorial package; see content.go.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/chuma-beep/mathua/internal/auth"
+	"github.com/chuma-beep/mathua/internal/engine"
+	"github.com/chuma-beep/mathua/internal/generator"
+	"github.com/chuma-beep/mathua/internal/grader"
+	"github.com/chuma-beep/mathua/internal/lessons"
+	"github.com/chuma-beep/mathua/internal/server"
+	"github.com/chuma-beep/mathua/internal/storage"
+)
+
+// The three concepts of the first pilot keep their IDs, so their stored progress stays valid.
+const (
+	literalID = "ts.value.numeric_literal"
+	typeID    = "ts.type.number"
+	constID   = "ts.binding.const_number"
+)
+
+// checker parses and typechecks learner input. It never executes that input.
+type checker struct {
+	node   string
+	script string
+}
+
+// graded is one verdict from grade.cjs. Error is set when a job could not be judged at all.
+type graded struct {
+	Correct  bool    `json:"correct"`
+	Score    float64 `json:"score"`
+	Feedback string  `json:"feedback"`
+	Error    string  `json:"error"`
+}
+
+const graderUnavailable = "O corretor TypeScript está indisponível. Sua resposta não foi contada como erro."
+
+func (g graded) result() grader.Result {
+	if g.Error != "" {
+		return grader.Result{Unavailable: true, Feedback: g.Error}
+	}
+	if g.Feedback == "" {
+		return grader.Result{Unavailable: true, Feedback: graderUnavailable}
+	}
+	return grader.Result{Correct: g.Correct, Score: g.Score, Feedback: g.Feedback}
+}
+
+func (c *checker) run(timeout time.Duration, input, output any) error {
+	raw, err := json.Marshal(input)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, c.node, "--max-old-space-size=256", c.script)
+	cmd.Stdin = bytes.NewReader(raw)
+	out, err := cmd.Output()
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(out, output)
+}
+
+// grade judges one answer. Any failure to obtain a verdict is reported as unavailable, which the
+// engine keeps apart from a wrong answer: nothing is recorded and the learner can retry.
+func (c *checker) grade(job gradeJob) grader.Result {
+	var verdict graded
+	if err := c.run(10*time.Second, job, &verdict); err != nil || verdict.Error != "" {
+		return grader.Result{Unavailable: true, Feedback: graderUnavailable}
+	}
+	return verdict.result()
+}
+
+func (c *checker) gradeBatch(jobs []gradeJob) ([]grader.Result, error) {
+	var out struct {
+		Results []graded `json:"results"`
+	}
+	if err := c.run(60*time.Second, map[string]any{"batch": jobs}, &out); err != nil {
+		return nil, err
+	}
+	if len(out.Results) != len(jobs) {
+		return nil, fmt.Errorf("grader returned %d verdicts for %d jobs", len(out.Results), len(jobs))
+	}
+	results := make([]grader.Result, len(jobs))
+	for i, verdict := range out.Results {
+		results[i] = verdict.result()
+	}
+	return results, nil
+}
+
+// newPilot loads the content package from contentDir and writes the lesson files into lessonsDir.
+func newPilot(repo storage.Repository, check *checker, contentDir, lessonsDir string) (*http.ServeMux, *engine.Engine, *content, error) {
+	c, err := loadContent(contentDir, integratedThroughStage)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	dag, err := c.dag()
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	reg := generator.NewRegistry()
+	for _, spec := range c.Concepts {
+		item, err := newExercise(spec, c.familiesOf(spec), check)
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		if err := reg.Register(spec.ID, item); err != nil {
+			return nil, nil, nil, err
+		}
+	}
+	if err := c.verifyModelAnswers(check); err != nil {
+		return nil, nil, nil, err
+	}
+	if err := c.writeLessons(lessonsDir); err != nil {
+		return nil, nil, nil, err
+	}
+	ll, err := lessons.Load(lessonsDir)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	eng := engine.New(repo, dag, reg, ll, nil)
+	mux := http.NewServeMux()
+	server.New(eng, repo, auth.New(repo)).Register(mux)
+	return mux, eng, c, nil
+}
+
+// Serve the existing Next.js export beside the API. Its client uses the same origin.
+func studyFrontend(root, firstConcept string) http.Handler {
+	files := http.FileServer(http.Dir(root))
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/" {
+			http.Redirect(w, r, "/learn?concept="+firstConcept, http.StatusFound)
+			return
+		}
+		clean := path.Clean(r.URL.Path)
+		if path.Ext(clean) == "" {
+			htmlPath := strings.TrimSuffix(clean, "/") + ".html"
+			if info, err := os.Stat(filepath.Join(root, filepath.FromSlash(htmlPath))); err == nil && !info.IsDir() {
+				r.URL.Path = htmlPath
+			}
+		}
+		files.ServeHTTP(w, r)
+	})
+}
+
+func main() {
+	addr := flag.String("addr", "127.0.0.1:8081", "HTTP listen address")
+	db := flag.String("db", "typescript-pilot.db", "SQLite database path")
+	node := flag.String("node", "node", "Node executable")
+	script := flag.String("grader", "cmd/typescript-pilot/grade.cjs", "TypeScript grader path")
+	web := flag.String("web", "web/next-app/out", "Existing Next.js static export directory")
+	contentFlag := flag.String("content", "", "Editorial content directory; default: "+contentDirName+" found above the working directory")
+	flag.Parse()
+	resolvedNode, err := exec.LookPath(*node)
+	if err != nil {
+		log.Fatal(err)
+	}
+	resolvedScript, err := filepath.Abs(*script)
+	if err != nil {
+		log.Fatal(err)
+	}
+	contentDir := *contentFlag
+	if contentDir == "" {
+		if contentDir, err = findContentDir("."); err != nil {
+			log.Fatal(err)
+		}
+	}
+	// The lesson files are derived from the content package on every start.
+	lessonsDir := *db + ".lessons"
+	if err := os.RemoveAll(lessonsDir); err != nil {
+		log.Fatal(err)
+	}
+	repo, err := storage.NewSQLiteStore(*db)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer repo.Close()
+	auth.SetSecretFile(*db + ".jwt")
+	mux, _, c, err := newPilot(repo, &checker{node: resolvedNode, script: resolvedScript}, contentDir, lessonsDir)
+	if err != nil {
+		log.Fatal(err)
+	}
+	cases := 0
+	for _, f := range c.families {
+		cases += len(f.Cases)
+	}
+	log.Printf("Content %s from %s: stages 1 to %d, %d concepts, %d families, %d cases, every model answer accepted by its grader",
+		c.Version, contentDir, integratedThroughStage, len(c.Concepts), len(c.families), cases)
+	if info, err := os.Stat(filepath.Join(*web, "learn.html")); err == nil && !info.IsDir() {
+		mux.Handle("/", studyFrontend(*web, c.Concepts[0].ID))
+		log.Printf("Study interface: http://%s", *addr)
+	} else {
+		log.Print("Study interface not built. Run NEXT_PUBLIC_TS_PILOT=1 NEXT_PUBLIC_SAME_ORIGIN_API=1 npm run build in web/next-app.")
+	}
+	log.Printf("TypeScript pilot API: http://%s", *addr)
+	srv := &http.Server{Addr: *addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	log.Fatal(srv.ListenAndServe())
+}
