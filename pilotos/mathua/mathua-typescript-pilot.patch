+// so a normal Mathua build renders exactly what it rendered before. The pilot reuses
+// the existing study page; this file only removes what does not apply to TypeScript
+// exercises and supplies Portuguese text for the study path.
+export const TS_PILOT = process.env.NEXT_PUBLIC_TS_PILOT === '1'
+
+// Destinations that show the bundled mathematics catalog instead of the pilot's concepts.
+const HIDDEN_HREFS: ReadonlySet<string> = new Set(['/graph', '/glossary'])
+
+/** Whether a navigation entry stays visible. Always true outside the pilot. */
+export function pilotShows(href: string): boolean {
+  return !TS_PILOT || !HIDDEN_HREFS.has(href)
+}
+
+/** The concept graph is the mathematics catalog; the pilot sends that link to the progress report. */
+export function pilotHref(href: string): string {
+  return TS_PILOT && (href === '/graph' || href.startsWith('/graph?')) ? '/reports' : href
+}
+
+/**
+ * The pilot's grader states in `feedback` what is wrong with this answer, for example that the
+ * task asks for `const`. The study page renders `diagnosis` and never `feedback`, so a wrong
+ * answer showed the model answer without the reason. Outside the pilot nothing changes.
+ */
+export function pilotDiagnosis(res: { correct: boolean; diagnosis?: string; feedback?: string }): string | undefined {
+  if (!TS_PILOT || res.correct || res.diagnosis) return res.diagnosis
+  return res.feedback || undefined
+}
+
+// Cases per section in the content package. The pilot's loader (casesPerFamily in content.go)
+// refuses a family of any other size, so one case always remains after five are excluded.
+const PILOT_BANK = 6
+
+/**
+ * What a pilot practice fetch excludes: the questions waiting in the buffer and the ones shown
+ * most recently, five in all. A section has six cases, so the server is left with the case shown
+ * longest ago: every case is reached before one repeats, and a missed case does not come back next.
+ */
+export function pilotExclude(shown: string[], buffered: string[]): string[] {
+  const picked: string[] = []
+  const add = (question: string) => {
+    if (picked.length < PILOT_BANK - 1 && !picked.includes(question)) picked.push(question)
+  }
+  // The two questions shown last go first, so the one just missed is never the case left over,
+  // however full the buffer is. Then the buffer, then older questions, newest first.
+  for (const question of shown.slice(-2).reverse()) add(question)
+  for (const question of buffered) add(question)
+  for (const question of [...shown].reverse()) add(question)
+  return picked
+}
+
+/** With few cases left the server repeats one inside a batch. Keep each once, and none already buffered. */
+export function pilotFresh<T extends { question: string }>(questions: T[], buffered: string[]): T[] {
+  const taken = new Set(buffered)
+  return questions.filter(q => {
+    if (taken.has(q.question)) return false
+    taken.add(q.question)
+    return true
+  })
+}
+
+/**
+ * What may join the buffer now. A fetch answers what was true when it was sent; by the time it
+ * arrives another fetch may have filled the buffer, or a question it carries may have been shown.
+ * So each fetched question is admitted once, and never when it is buffered or was shown recently.
+ */
+export function pilotAdmit<T extends { question: string }>(fresh: T[], buffered: string[], shown: string[]): T[] {
+  return pilotFresh(fresh, [...buffered, ...shown.slice(-(PILOT_BANK - 1))])
+}
+
+/**
+ * The questions to use from a fetch the page waited for because its buffer was empty. It is what
+ * pilotAdmit lets through; when that is nothing, it is what the server sent, except the question
+ * shown last. The pilot's own filter must never be the reason a section ends.
+ */
+export function pilotUsable<T extends { question: string }>(fresh: T[], shown: string[]): T[] {
+  const admitted = pilotAdmit(fresh, [], shown)
+  if (admitted.length > 0) return admitted
+  const last = shown[shown.length - 1]
+  return pilotFresh(fresh, []).filter(q => q.question !== last)
+}
