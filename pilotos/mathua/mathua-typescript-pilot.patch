+// This pilot composes Mathua's existing engine and HTTP API with TypeScript exercises.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"math/rand"
+	"net/http"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/chuma-beep/mathua/internal/auth"
+	"github.com/chuma-beep/mathua/internal/concepts"
+	"github.com/chuma-beep/mathua/internal/engine"
+	"github.com/chuma-beep/mathua/internal/generator"
+	"github.com/chuma-beep/mathua/internal/grader"
+	"github.com/chuma-beep/mathua/internal/lessons"
+	"github.com/chuma-beep/mathua/internal/server"
+	"github.com/chuma-beep/mathua/internal/storage"
+)
+
+const (
+	literalID = "ts.value.numeric_literal"
+	typeID    = "ts.type.number"
+	constID   = "ts.binding.const_number"
+)
+
+// checker parses and typechecks learner input. It never executes that input.
+type checker struct {
+	node   string
+	script string
+}
+
+func (c *checker) grade(kind, expected, answer string) grader.Result {
+	input, err := json.Marshal(map[string]string{"kind": kind, "expected": expected, "answer": answer})
+	if err != nil {
+		return grader.Result{Unavailable: true, Feedback: "Não foi possível preparar a correção."}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, c.node, "--max-old-space-size=256", c.script)
+	cmd.Stdin = bytes.NewReader(input)
+	output, err := cmd.Output()
+	var result grader.Result
+	if err != nil || json.Unmarshal(output, &result) != nil || result.Feedback == "" {
+		return grader.Result{Unavailable: true, Feedback: "O corretor TypeScript está indisponível. Sua resposta não foi contada como erro."}
+	}
+	return result
+}
+
+type exercise struct {
+	kind  string
+	check *checker
+	draw  atomic.Int64
+}
+
+func (g *exercise) Generate(ctx generator.GeneratorContext) generator.Problem {
+	// Mathua calls Generate repeatedly with one context in a batch. The local
+	// counter varies those draws. Reports replay the stored question and answer.
+	rng := rand.New(rand.NewSource(ctx.Seed + g.draw.Add(1)))
+	names := []string{"amount", "reviewLimit", "refundAmount", "limit"}
+	name := names[rng.Intn(len(names))]
+	value := 1000 + rng.Intn(19001)
+	var p generator.Problem
+	switch g.kind {
+	case "literal":
+		words := []string{"um", "dois", "três", "quatro", "cinco", "seis", "sete", "oito", "nove", "dez", "onze", "doze", "treze", "catorze", "quinze", "dezesseis", "dezessete", "dezoito", "dezenove", "vinte"}
+		n := rng.Intn(len(words))
+		value = (n + 1) * 1000
+		amount := words[n] + " mil"
+		if n == 0 {
+			amount = "mil"
+		}
+		p.Question = fmt.Sprintf("O valor de um reembolso é %s. Escreva somente um literal numérico TypeScript que represente esse valor.", amount)
+		p.Answer = fmt.Sprint(value)
+		p.Explanation = fmt.Sprintf("%d é um literal numérico: uma expressão que representa diretamente esse valor. Com aspas, seria um literal de texto.", value)
+	case "type":
+		p.Question = fmt.Sprintf("Complete somente a anotação de tipo: const %s: ___ = %d. Qual palavra TypeScript designa o tipo numérico?", name, value)
+		p.Answer = "number"
+		p.Explanation = fmt.Sprintf("number nomeia o tipo numérico. %d é um valor desse tipo. %s é o nome vinculado ao valor na declaração.", value, name)
+	case "const":
+		p.Question = fmt.Sprintf("Declare somente uma constante chamada %s, inicializada com o literal numérico %d. A anotação number é opcional.", name, value)
+		p.Answer = fmt.Sprintf("const %s: number = %d;", name, value)
+		p.Explanation = fmt.Sprintf("%s A declaração cria o vínculo entre o nome %s e o valor %d. const impede reatribuir esse nome. A anotação number pode ser omitida neste exercício.", p.Answer, name, value)
+	}
+	return p
+}
+
+func (g *exercise) Grade(expected, answer string) grader.Result {
+	return g.check.grade(g.kind, expected, answer)
+}
+
+func (g *exercise) AnswerFormat() generator.AnswerFormat {
+	return generator.AnswerFormat{InputMode: "text", Hint: "Digite somente a resposta solicitada, sem bloco Markdown."}
+}
+
+func newPilot(repo storage.Repository, check *checker) (*http.ServeMux, *engine.Engine, error) {
+	// These prerequisite edges are a teaching choice for this narrow pilot.
+	// They do not claim that every TypeScript course needs this sequence.
+	dag, err := concepts.Build([]concepts.Concept{
+		{ID: literalID, Label: "Valor e literal numérico", Domain: "typescript", GradingType: "numeric",
+			MasteryThreshold: concepts.MasteryThreshold{Streak: 3, AvgTimeSeconds: 60}},
+		{ID: typeID, Label: "Tipo number", Domain: "typescript", GradingType: "expression",
+			MasteryThreshold: concepts.MasteryThreshold{Streak: 3, AvgTimeSeconds: 60}},
+		{ID: constID, Label: "Declaração const com valor numérico", Domain: "typescript", GradingType: "expression",
+			Prerequisites: []string{literalID, typeID}, MasteryThreshold: concepts.MasteryThreshold{Streak: 3, AvgTimeSeconds: 60}},
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	reg := generator.NewRegistry()
+	for _, item := range []struct{ id, kind string }{{literalID, "literal"}, {typeID, "type"}, {constID, "const"}} {
+		if err := reg.Register(item.id, &exercise{kind: item.kind, check: check}); err != nil {
+			return nil, nil, err
+		}
+	}
+	ll, err := lessons.Load(filepath.Join(filepath.Dir(check.script), "lessons"))
+	if err != nil {
+		return nil, nil, err
+	}
+	eng := engine.New(repo, dag, reg, ll, nil)
+	mux := http.NewServeMux()
+	server.New(eng, repo, auth.New(repo)).Register(mux)
+	return mux, eng, nil
+}
+
+// Serve the existing Next.js export beside the API. Its client uses the same origin.
+func studyFrontend(root string) http.Handler {
+	files := http.FileServer(http.Dir(root))
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/" {
+			http.Redirect(w, r, "/learn?concept="+literalID, http.StatusFound)
+			return
+		}
+		clean := path.Clean(r.URL.Path)
+		if path.Ext(clean) == "" {
+			htmlPath := strings.TrimSuffix(clean, "/") + ".html"
+			if info, err := os.Stat(filepath.Join(root, filepath.FromSlash(htmlPath))); err == nil && !info.IsDir() {
+				r.URL.Path = htmlPath
+			}
+		}
+		files.ServeHTTP(w, r)
+	})
+}
+
+func main() {
+	addr := flag.String("addr", "127.0.0.1:8081", "HTTP listen address")
+	db := flag.String("db", "typescript-pilot.db", "SQLite database path")
+	node := flag.String("node", "node", "Node executable")
+	script := flag.String("grader", "cmd/typescript-pilot/grade.cjs", "TypeScript grader path")
+	web := flag.String("web", "web/next-app/out", "Existing Next.js static export directory")
+	flag.Parse()
+	resolvedNode, err := exec.LookPath(*node)
+	if err != nil {
+		log.Fatal(err)
+	}
+	resolvedScript, err := filepath.Abs(*script)
+	if err != nil {
+		log.Fatal(err)
+	}
+	repo, err := storage.NewSQLiteStore(*db)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer repo.Close()
+	auth.SetSecretFile(*db + ".jwt")
+	mux, _, err := newPilot(repo, &checker{node: resolvedNode, script: resolvedScript})
+	if err != nil {
+		log.Fatal(err)
+	}
+	if info, err := os.Stat(filepath.Join(*web, "learn.html")); err == nil && !info.IsDir() {
+		mux.Handle("/", studyFrontend(*web))
+		log.Printf("Study interface: http://%s", *addr)
+	} else {
+		log.Print("Study interface not built. Run NEXT_PUBLIC_TS_PILOT=1 NEXT_PUBLIC_SAME_ORIGIN_API=1 npm run build in web/next-app.")
+	}
+	log.Printf("TypeScript pilot API: http://%s", *addr)
+	srv := &http.Server{Addr: *addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	log.Fatal(srv.ListenAndServe())
+}
