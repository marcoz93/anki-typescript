+// Switches for the TypeScript pilot served by cmd/typescript-pilot.
+//
+// Everything here is off unless the interface is built with NEXT_PUBLIC_TS_PILOT=1,
+// so a normal Mathua build renders exactly what it rendered before. The pilot reuses
+// the existing study page; this file only removes what does not apply to TypeScript
+// exercises and supplies Portuguese text for the study path.
+export const TS_PILOT = process.env.NEXT_PUBLIC_TS_PILOT === '1'
+
+// Destinations that show the bundled mathematics catalog instead of the pilot's concepts.
+const HIDDEN_HREFS: ReadonlySet<string> = new Set(['/graph', '/glossary'])
+
+/** Whether a navigation entry stays visible. Always true outside the pilot. */
+export function pilotShows(href: string): boolean {
+  return !TS_PILOT || !HIDDEN_HREFS.has(href)
+}
+
+/** The concept graph is the mathematics catalog; the pilot sends that link to the progress report. */
+export function pilotHref(href: string): string {
+  return TS_PILOT && (href === '/graph' || href.startsWith('/graph?')) ? '/reports' : href
+}
