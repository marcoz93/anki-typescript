+	}
+	session, err := e.store.CreateSession(student.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// This fixture simulates a historical overly strict grader. The pilot itself
+	// never rejects the omitted annotation when the prompt makes it optional.
+	_, err = e.store.RecordAttempt(storage.AttemptEntry{SessionID: session.ID, StudentID: student.ID, ConceptID: constID,
+		Answer: "const amount = 15000;", Expected: "const amount: number = 15000;", Correct: false,
+		Question:       "Declare somente uma constante chamada amount, inicializada com o literal numérico 15000. A anotação number é opcional.",
+		ElapsedSeconds: 30, Timestamp: time.Now().UTC(), Source: "practice"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, _ := e.store.GetAllAttempts()
+	dry, err := repair.Run(e.eng, e.store, e.eng.GetDAG(), true, io.Discard)
+	if err != nil || dry.Repaired != 1 || dry.ProgressWrites != 0 {
+		t.Fatalf("repair preview: %+v, %v", dry, err)
+	}
+	afterPreview, _ := e.store.GetAllAttempts()
+	if !reflect.DeepEqual(before, afterPreview) {
+		t.Fatal("dry run changed attempts")
+	}
+	applied, err := repair.Run(e.eng, e.store, e.eng.GetDAG(), false, io.Discard)
+	after, _ := e.store.GetAllAttempts()
+	updatedStudent, _ := e.store.GetStudent(student.ID)
+	if err != nil || applied.Repaired != 1 || applied.ProgressWrites != 1 || !after[0].Correct || updatedStudent.XPTotal != student.XPTotal {
+		t.Fatalf("native repair: %+v, error=%v, attempts=%+v", applied, err, after)
+	}
+	progress, err := e.store.GetProgress(student.ID, constID)
+	if err != nil || progress.Attempts != 1 || progress.Status == "MASTERED" {
+		t.Fatalf("repair invented mastery: %+v, %v", progress, err)
+	}
+}
