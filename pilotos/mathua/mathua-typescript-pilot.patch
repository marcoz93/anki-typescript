+	"time"
+
+	"github.com/chuma-beep/mathua/internal/auth"
+	"github.com/chuma-beep/mathua/internal/engine"
+	"github.com/chuma-beep/mathua/internal/generator"
+	"github.com/chuma-beep/mathua/internal/grader"
+	"github.com/chuma-beep/mathua/internal/lessons"
+	"github.com/chuma-beep/mathua/internal/mastery"
+	"github.com/chuma-beep/mathua/internal/repair"
+	"github.com/chuma-beep/mathua/internal/storage"
+)
+
+func testChecker(t *testing.T) *checker {
+	t.Helper()
+	node, err := exec.LookPath("node")
+	if err != nil {
+		t.Fatal(err)
+	}
+	script, err := filepath.Abs("grade.cjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &checker{node: node, script: script}
+}
+
+var (
+	contentOnce sync.Once
+	contentPath string
+	contentData *content
+	contentErr  error
+)
+
+// testContent loads the editorial package the pilot serves, from the repository above this clone.
+func testContent(t *testing.T) (string, *content) {
+	t.Helper()
+	contentOnce.Do(func() {
+		if contentPath, contentErr = findContentDir("."); contentErr == nil {
+			contentData, contentErr = loadContent(contentPath, integratedThroughStage)
+		}
+	})
+	if contentErr != nil {
+		t.Fatal(contentErr)
+	}
+	return contentPath, contentData
+}
+
+// Each kind is one family of the content package and its answer mode.
+var criteriaKinds = map[string][2]string{
+	"literal": {"F002", "code"}, "text": {"F003", "code"}, "boolean": {"F004", "code"},
+	"type": {"F005", "token"}, "token": {"F012", "token"}, "choice": {"F001", "choice"},
+	"const": {"F010", "code"}, "const_text": {"F011", "code"},
+}
+
+func TestTypeScriptCriteria(t *testing.T) {
+	check := testChecker(t)
+	const expectedText = `const id: string = "reembolso-01";`
+	const expected = "const amount: number = 15000;"
+	cases := []struct {
+		name, kind, reference, answer string
+		correct                       bool
+	}{
+		{"literal", "literal", "15000", "15000", true},
+		{"numeric_separator", "literal", "15000", "15_000", true},
+		{"literal_is_not_a_string", "literal", "15000", `"15000"`, false},
+		{"literal_is_not_an_operation", "literal", "15000", "10000 + 5000", false},
+		{"wrong_literal", "literal", "15000", "15001", false},
+		{"type_name", "type", "number", "number", true},
+		{"value_is_not_type_name", "type", "number", "15000", false},
+		{"number_is_not_string", "type", "number", "string", false},
+		{"explicit_number", "const", expected, expected, true},
+		{"inferred_number", "const", expected, "const amount = 15000;", true},
+		{"spacing_and_comment", "const", expected, "// valor\nconst amount : number = 15_000 ;", true},
+		{"let_is_not_const", "const", expected, "let amount: number = 15000;", false},
+		{"wrong_name", "const", expected, "const other: number = 15000;", false},
+		{"wrong_value", "const", expected, "const amount: number = 15001;", false},
+		{"string_initializer", "const", expected, `const amount = "15000";`, false},
+		{"wrong_annotation", "const", expected, "const amount: string = 15000;", false},
+		{"syntax_error", "const", expected, "const amount: number = ;", false},
+		{"no_extra_statement", "const", expected, expected + " while (true) {}", false},
+		{"no_comment_disguise", "const", expected, "// " + expected + "\nlet amount = 15000;", false},
+		{"compiler_diagnostic", "const", expected, "/// <reference path=\"missing.ts\" />\n" + expected, false},
+		{"empty_answer", "const", expected, "", false},
+		{"text_double_quotes", "text", `"reembolso-01"`, `"reembolso-01"`, true},
+		{"text_single_quotes_are_equivalent", "text", `"reembolso-01"`, `'reembolso-01'`, true},
+		{"text_without_quotes", "text", `"reembolso-01"`, `reembolso`, false},
+		{"text_other_content", "text", `"reembolso-01"`, `"reembolso-02"`, false},
+		{"text_template_is_another_notation", "text", `"reembolso-01"`, "`reembolso-01`", false},
+		{"text_is_not_a_number", "text", `"reembolso-01"`, "15000", false},
+		{"boolean_false", "boolean", "false", "false", true},
+		{"boolean_true_with_semicolon", "boolean", "true", "true;", true},
+		{"boolean_in_quotes_is_text", "boolean", "false", `"false"`, false},
+		{"boolean_opposite_value", "boolean", "false", "true", false},
+		{"boolean_capitalized_is_a_name", "boolean", "true", "True", false},
+		{"type_string", "type", "string", "string", true},
+		{"type_name_case_matters", "type", "number", "Number", false},
+		{"token_colon_with_spaces", "token", ":", " : ", true},
+		{"token_equals_is_not_colon", "token", ":", "=", false},
+		{"choice_text_of_the_correct_alternative", "choice", "Uma notação que expressa diretamente um valor.", "Uma notação que expressa diretamente um valor.", true},
+		{"choice_text_of_another_alternative", "choice", "Uma notação que expressa diretamente um valor.", "Uma regra que proíbe todos os valores.", false},
+		{"choice_unresolved_letter", "choice", "Uma notação que expressa diretamente um valor.", "Z", false},
+		{"text_const_explicit", "const_text", expectedText, expectedText, true},
+		{"text_const_inferred_single_quotes_no_semicolon", "const_text", expectedText, "const id = 'reembolso-01'", true},
+		{"text_const_let_is_not_const", "const_text", expectedText, `let id = "reembolso-01";`, false},
+		{"text_const_number_initializer", "const_text", expectedText, "const id = 1;", false},
+		{"text_const_wrong_annotation", "const_text", expectedText, `const id: number = "reembolso-01";`, false},
+		{"text_const_wrong_name", "const_text", expectedText, `const code: string = "reembolso-01";`, false},
+		{"number_const_parenthesized_literal", "const", expected, "const amount = (15000);", true},
+		{"text_const_parenthesized_literal", "const_text", expectedText, `const id: string = ("reembolso-01");`, true},
+		{"number_const_sum_is_not_a_literal", "const", expected, "const amount = (10000 + 5000);", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			kind := criteriaKinds[tc.kind]
+			got := check.grade(gradeJob{Family: kind[0], Mode: kind[1], Expected: tc.reference, Answer: tc.answer})
+			if got.Unavailable || got.Correct != tc.correct || got.Feedback == "" {
+				t.Fatalf("grade = %+v, want correct=%t", got, tc.correct)
+			}
+		})
+	}
+	// A family without a grader is a technical failure. It must never read as a wrong answer.
+	t.Run("family_without_grader_is_not_graded", func(t *testing.T) {
+		got := check.grade(gradeJob{Family: "F999", Mode: "code", Expected: "1", Answer: "1"})
+		if !got.Unavailable || got.Correct {
+			t.Fatalf("grade = %+v, want unavailable", got)
+		}
+	})
+}
