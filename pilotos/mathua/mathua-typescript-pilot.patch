+		{"no_extra_statement", "const", expected, expected + " while (true) {}", false},
+		{"no_comment_disguise", "const", expected, "// " + expected + "\nlet amount = 15000;", false},
+		{"compiler_diagnostic", "const", expected, "/// <reference path=\"missing.ts\" />\n" + expected, false},
+		{"empty_answer", "const", expected, "", false},
+		{"text_double_quotes", "text", `"reembolso-01"`, `"reembolso-01"`, true},
+		{"text_single_quotes_are_equivalent", "text", `"reembolso-01"`, `'reembolso-01'`, true},
+		{"text_without_quotes", "text", `"reembolso-01"`, `reembolso`, false},
+		{"text_other_content", "text", `"reembolso-01"`, `"reembolso-02"`, false},
+		{"text_template_is_another_notation", "text", `"reembolso-01"`, "`reembolso-01`", false},
+		{"text_is_not_a_number", "text", `"reembolso-01"`, "15000", false},
+		{"boolean_false", "boolean", "false", "false", true},
+		{"boolean_true_with_semicolon", "boolean", "true", "true;", true},
+		{"boolean_in_quotes_is_text", "boolean", "false", `"false"`, false},
+		{"boolean_opposite_value", "boolean", "false", "true", false},
+		{"boolean_capitalized_is_a_name", "boolean", "true", "True", false},
+		{"type_string", "type", "string", "string", true},
+		{"type_name_case_matters", "type", "number", "Number", false},
+		{"token_colon_with_spaces", "token", ":", " : ", true},
+		{"token_equals_is_not_colon", "token", ":", "=", false},
+		{"choice_text_of_the_correct_alternative", "choice", "Uma notação que expressa diretamente um valor.", "Uma notação que expressa diretamente um valor.", true},
+		{"choice_text_of_another_alternative", "choice", "Uma notação que expressa diretamente um valor.", "Uma regra que proíbe todos os valores.", false},
+		{"choice_unresolved_letter", "choice", "Uma notação que expressa diretamente um valor.", "Z", false},
+		{"text_const_explicit", "const_text", expectedText, expectedText, true},
+		{"text_const_inferred_single_quotes_no_semicolon", "const_text", expectedText, "const id = 'reembolso-01'", true},
+		{"text_const_let_is_not_const", "const_text", expectedText, `let id = "reembolso-01";`, false},
+		{"text_const_number_initializer", "const_text", expectedText, "const id = 1;", false},
+		{"text_const_wrong_annotation", "const_text", expectedText, `const id: number = "reembolso-01";`, false},
+		{"text_const_wrong_name", "const_text", expectedText, `const code: string = "reembolso-01";`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			kind := criteriaKinds[tc.kind]
+			got := check.grade(gradeJob{Family: kind[0], Mode: kind[1], Expected: tc.reference, Answer: tc.answer})
+			if got.Unavailable || got.Correct != tc.correct || got.Feedback == "" {
+				t.Fatalf("grade = %+v, want correct=%t", got, tc.correct)
