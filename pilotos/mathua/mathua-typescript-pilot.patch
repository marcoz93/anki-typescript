+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/chuma-beep/mathua/internal/auth"
+	"github.com/chuma-beep/mathua/internal/engine"
+	"github.com/chuma-beep/mathua/internal/mastery"
+	"github.com/chuma-beep/mathua/internal/repair"
+	"github.com/chuma-beep/mathua/internal/storage"
+)
+
+func testChecker(t *testing.T) *checker {
+	t.Helper()
+	node, err := exec.LookPath("node")
+	if err != nil {
+		t.Fatal(err)
+	}
+	script, err := filepath.Abs("grade.cjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &checker{node: node, script: script}
+}
+
+func TestTypeScriptCriteria(t *testing.T) {
+	check := testChecker(t)
+	const expected = "const amount: number = 15000;"
+	cases := []struct {
+		name, kind, reference, answer string
+		correct                       bool
+	}{
+		{"literal", "literal", "15000", "15000", true},
+		{"numeric_separator", "literal", "15000", "15_000", true},
+		{"literal_is_not_a_string", "literal", "15000", `"15000"`, false},
+		{"literal_is_not_an_operation", "literal", "15000", "10000 + 5000", false},
+		{"wrong_literal", "literal", "15000", "15001", false},
+		{"type_name", "type", "number", "number", true},
+		{"value_is_not_type_name", "type", "number", "15000", false},
+		{"number_is_not_string", "type", "number", "string", false},
+		{"explicit_number", "const", expected, expected, true},
+		{"inferred_number", "const", expected, "const amount = 15000;", true},
+		{"spacing_and_comment", "const", expected, "// valor\nconst amount : number = 15_000 ;", true},
+		{"let_is_not_const", "const", expected, "let amount: number = 15000;", false},
+		{"wrong_name", "const", expected, "const other: number = 15000;", false},
+		{"wrong_value", "const", expected, "const amount: number = 15001;", false},
+		{"string_initializer", "const", expected, `const amount = "15000";`, false},
+		{"wrong_annotation", "const", expected, "const amount: string = 15000;", false},
+		{"syntax_error", "const", expected, "const amount: number = ;", false},
+		{"no_extra_statement", "const", expected, expected + " while (true) {}", false},
+		{"no_comment_disguise", "const", expected, "// " + expected + "\nlet amount = 15000;", false},
+		{"compiler_diagnostic", "const", expected, "/// <reference path=\"missing.ts\" />\n" + expected, false},
+		{"empty_answer", "const", expected, "", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := check.grade(tc.kind, tc.reference, tc.answer)
+			if got.Unavailable || got.Correct != tc.correct || got.Feedback == "" {
+				t.Fatalf("grade = %+v, want correct=%t", got, tc.correct)
+			}
+		})
+	}
+}
+
+type pilotEnv struct {
+	http  *httptest.Server
+	store *storage.SQLiteStore
+	eng   *engine.Engine
+}
+
+func boot(t *testing.T, db string, check *checker) *pilotEnv {
+	t.Helper()
+	store, err := storage.NewSQLiteStore(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mux, eng, err := newPilot(store, check)
+	if err != nil {
+		store.Close()
+		t.Fatal(err)
+	}
+	e := &pilotEnv{http: httptest.NewServer(mux), store: store, eng: eng}
+	return e
+}
+
+func (e *pilotEnv) request(t *testing.T, method, route, token string, body any, wantStatus int) (map[string]any, string) {
+	t.Helper()
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	req, err := http.NewRequest(method, e.http.URL+route, bytes.NewReader(encoded))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	client := &http.Client{Timeout: 15 * time.Second}
+	res, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	data, err := io.ReadAll(res.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.StatusCode != wantStatus {
+		t.Fatalf("%s %s: status %d, want %d: %s", method, route, res.StatusCode, wantStatus, data)
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatalf("JSON: %v: %s", err, data)
+	}
+	return decoded, string(data)
+}
+
+func (e *pilotEnv) question(t *testing.T, token, concept string, excluded ...string) string {
+	t.Helper()
+	query := url.Values{"count": {"1"}}
+	for _, q := range excluded {
+		query.Add("exclude", q)
+	}
+	res, raw := e.request(t, "GET", "/api/lessons/"+concept+"/practice?"+query.Encode(), token, nil, 200)
+	questions := res["questions"].([]any)
+	if len(questions) != 1 {
+		t.Fatalf("want one question: %s", raw)
+	}
+	q := questions[0].(map[string]any)
+	if _, exposed := q["answer"]; exposed || q["answer_input_mode"] != "text" {
+		t.Fatalf("answer leaked or input excludes TypeScript: %s", raw)
+	}
+	return q["question"].(string)
+}
+
+func submission(concept, question, answer, id string) map[string]any {
+	return map[string]any{"concept_id": concept, "question": question, "answer": answer, "submission_id": id, "elapsed": 30}
+}
+
+// Test answers are obtained from the prompt. The client never reads an anchor.
+func solve(t *testing.T, concept, question string) string {
+	t.Helper()
+	switch concept {
+	case typeID:
+		return "number"
+	case literalID:
+		amounts := map[string]int{"mil": 1000, "dois mil": 2000, "três mil": 3000, "quatro mil": 4000,
+			"cinco mil": 5000, "seis mil": 6000, "sete mil": 7000, "oito mil": 8000, "nove mil": 9000,
+			"dez mil": 10000, "onze mil": 11000, "doze mil": 12000, "treze mil": 13000, "catorze mil": 14000,
+			"quinze mil": 15000, "dezesseis mil": 16000, "dezessete mil": 17000, "dezoito mil": 18000,
+			"dezenove mil": 19000, "vinte mil": 20000}
+		parts := strings.SplitN(question, ".", 2)
+		amount := strings.TrimPrefix(parts[0], "O valor de um reembolso é ")
+		if value, ok := amounts[amount]; ok {
+			return fmt.Sprint(value)
+		}
+	case constID:
+		match := regexp.MustCompile(`chamada ([A-Za-z]+), inicializada com o literal numérico ([0-9]+)`).FindStringSubmatch(question)
+		if len(match) == 3 {
+			return fmt.Sprintf("const %s = %s;", match[1], match[2])
+		}
+	}
+	t.Fatalf("cannot answer prompt: %s", question)
+	return ""
+}
+
+func TestPilotHTTP(t *testing.T) {
+	t.Setenv("MATHUA_DEV_UNLOCK", "")
+	check := testChecker(t)
+	db := filepath.Join(t.TempDir(), "pilot.db")
+	e := boot(t, db, check)
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	guest, _ := e.request(t, "POST", "/api/auth/guest", "", map[string]any{}, 200)
+	token, student := guest["token"].(string), guest["student_id"].(string)
+
+	if !t.Run("prerequisites_block_practice_and_answer", func(t *testing.T) {
+		_, practice := e.request(t, "GET", "/api/lessons/"+constID+"/practice", token, nil, 403)
+		_, answer := e.request(t, "POST", "/api/study/answer", token, submission(constID, "", "const amount = 15000;", "locked"), 403)
+		if !strings.Contains(practice, "TOPIC_LOCKED") || !strings.Contains(answer, "TOPIC_LOCKED") {
+			t.Fatal("missing prerequisite verdict")
+		}
+		attempts, err := e.store.GetAllAttempts()
+		if err != nil || len(attempts) != 0 {
+			t.Fatalf("locked answer wrote evidence: %v, %v", attempts, err)
+		}
+	}) {
+		return
+	}
+
+	if !t.Run("native_mastery_unlocks_from_real_submissions", func(t *testing.T) {
+		for _, concept := range []string{literalID, typeID} {
+			seen := []string{}
+			for i := 0; i < mastery.MasteryEvidenceFloor; i++ {
+				q := e.question(t, token, concept, seen...)
+				for _, previous := range seen {
+					if previous == q {
+						t.Fatal("repeated a root exercise within the tested learning run")
+					}
+				}
+				seen = append(seen, q)
+				answer := solve(t, concept, q)
+				res, raw := e.request(t, "POST", "/api/study/answer", token, submission(concept, q, answer, fmt.Sprintf("%s-%d", concept, i)), 200)
+				if res["correct"] != true || res["ungraded"] == true {
+					t.Fatal(raw)
+				}
+				if i == 0 && res["new_status"] == "MASTERED" {
+					t.Fatal("one answer was treated as mastery")
+				}
+			}
+			progress, err := e.store.GetProgress(student, concept)
+			if err != nil || progress.Status != "MASTERED" || progress.Attempts != mastery.MasteryEvidenceFloor {
+				t.Fatalf("native progress = %+v, error=%v", progress, err)
+			}
+			t.Logf("%s: %d distinct submitted answers, status %s", concept, progress.Attempts, progress.Status)
+			if concept == literalID {
+				e.request(t, "GET", "/api/lessons/"+constID+"/practice", token, nil, 403)
+			}
+		}
+	}) {
+		return
+	}
+
+	var correctQuestion, correctAnswer, correctResponse string
+	var correctSubmission map[string]any
+	if !t.Run("wrong_answer_then_fresh_variant_and_valid_inference", func(t *testing.T) {
+		q := e.question(t, token, constID)
+		wrong := strings.Replace(solve(t, constID, q), "const ", "let ", 1)
+		res, _ := e.request(t, "POST", "/api/study/answer", token, submission(constID, q, wrong, "const-miss"), 200)
+		if res["correct"] != false || !strings.Contains(res["feedback"].(string), "const") || res["explanation"] == "" {
+			t.Fatalf("missing specific correction: %+v", res)
+		}
+		t.Logf("miss: %s | answer: %s | feedback: %v", q, wrong, res["feedback"])
+		correctQuestion = e.question(t, token, constID, q)
+		if correctQuestion == q {
+			t.Fatal("miss re-served the identical question")
+		}
+		correctAnswer = solve(t, constID, correctQuestion)
+		correctSubmission = submission(constID, correctQuestion, correctAnswer, "const-correct")
+		res, correctResponse = e.request(t, "POST", "/api/study/answer", token, correctSubmission, 200)
+		if res["correct"] != true || res["ungraded"] == true {
+			t.Fatal(correctResponse)
+		}
+		t.Logf("fresh: %s | answer: %s | feedback: %v", correctQuestion, correctAnswer, res["feedback"])
+	}) {
+		return
+	}
+
+	if !t.Run("retry_is_idempotent_and_changed_payload_conflicts", func(t *testing.T) {
+		before, err := e.store.GetAllAttempts()
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, again := e.request(t, "POST", "/api/study/answer", token, correctSubmission, 200)
+		if again != correctResponse {
+			t.Fatal("retry did not replay the original response")
+		}
+		changed := submission(constID, correctQuestion, "let amount = 1;", "const-correct")
+		e.request(t, "POST", "/api/study/answer", token, changed, 409)
+		after, err := e.store.GetAllAttempts()
+		if err != nil || !reflect.DeepEqual(before, after) {
+			t.Fatal("retry or conflicting payload changed attempts")
+		}
+	}) {
+		return
+	}
+
+	var reportID int64
+	const resolution = "Revisado: a anotação number é opcional neste exercício. A resposta sem anotação é válida."
+	if !t.Run("feedback_replay_resolution_and_private_history", func(t *testing.T) {
+		before, err := e.store.GetAllProgress(student)
+		if err != nil {
+			t.Fatal(err)
+		}
+		attemptsBefore, _ := e.store.GetAllAttempts()
+		expected := strings.Replace(correctAnswer, " = ", ": number = ", 1)
+		payload := map[string]any{"concept_id": constID, "kind": "question", "source": "practice", "reason": "unclear",
+			"question": correctQuestion, "expected": expected, "answer_given": correctAnswer, "answer_input_mode": "text",
+			"detail": "Preciso escrever number mesmo quando o enunciado diz que é opcional?"}
+		created, _ := e.request(t, "POST", "/api/reports", token, payload, 200)
+		reportID = int64(created["id"].(float64))
+		stored, err := e.store.GetReport(reportID)
+		if err != nil || stored.Question != correctQuestion || stored.AnswerGiven != correctAnswer || stored.ReporterID != student || stored.Status != "open" {
+			t.Fatalf("report snapshot = %+v, error=%v", stored, err)
+		}
+		adminToken, adminUser, err := auth.New(e.store).Signup("Reviewer", "reviewer", "Review-test-159!")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := e.store.SetStudentRole(adminUser.ID, storage.RoleOwner); err != nil {
+			t.Fatal(err)
+		}
+		route := fmt.Sprintf("/api/admin/reports/%d", reportID)
+		e.request(t, "POST", route+"/grade", token, map[string]any{}, 403)
+		replayed, raw := e.request(t, "POST", route+"/grade", adminToken, map[string]any{}, 200)
+		if replayed["correct"] != true || replayed["writes"] != false || replayed["unavailable"] != false {
+			t.Fatal(raw)
+		}
+		e.request(t, "PATCH", route, adminToken, map[string]any{"status": "resolved", "resolution": resolution}, 200)
+		mine, _ := e.request(t, "GET", "/api/reports/mine", token, nil, 200)
+		reports := mine["reports"].([]any)
+		if len(reports) != 1 || reports[0].(map[string]any)["resolution"] != resolution || mine["unread"] != float64(1) {
+			t.Fatalf("learner did not receive the resolution: %+v", mine)
+		}
+		other, _ := e.request(t, "POST", "/api/auth/guest", "", map[string]any{}, 200)
+		otherHistory, _ := e.request(t, "GET", "/api/reports/mine", other["token"].(string), nil, 200)
+		if len(otherHistory["reports"].([]any)) != 0 {
+			t.Fatal("report leaked to another learner")
+		}
+		after, err := e.store.GetAllProgress(student)
+		attemptsAfter, _ := e.store.GetAllAttempts()
+		if err != nil || !reflect.DeepEqual(before, after) || !reflect.DeepEqual(attemptsBefore, attemptsAfter) {
+			t.Fatal("reporting or replay changed learning evidence")
+		}
+		t.Logf("report %d: open -> resolved, grader replay correct, learner notified, attempts unchanged", reportID)
+	}) {
+		return
+	}
+
+	if !t.Run("database_and_unanswered_question_survive_restart", func(t *testing.T) {
+		pending := e.question(t, token, constID, correctQuestion)
+		before, err := e.store.GetAllAttempts()
+		if err != nil {
+			t.Fatal(err)
+		}
+		e.http.Close()
+		e.eng.Close()
+		if err := e.store.Close(); err != nil {
+			t.Fatal(err)
+		}
+		e = boot(t, db, check)
+		_, retry := e.request(t, "POST", "/api/study/answer", token, correctSubmission, 200)
+		after, err := e.store.GetAllAttempts()
+		if err != nil || !reflect.DeepEqual(before, after) || retry != correctResponse {
+			t.Fatal("persisted retry wrote evidence or changed response")
+		}
+		stored, err := e.store.GetReport(reportID)
+		if err != nil || stored.Status != "resolved" || stored.Resolution != resolution {
+			t.Fatalf("report lost after restart: %+v, %v", stored, err)
+		}
+		res, raw := e.request(t, "POST", "/api/study/answer", token, submission(constID, pending, solve(t, constID, pending), "after-restart"), 200)
+		if res["correct"] != true {
+			t.Fatalf("server anchor lost after restart: %s", raw)
+		}
+	}) {
+		return
+	}
+
+	t.Run("compiler_failure_is_ungraded_without_penalty_and_can_retry", func(t *testing.T) {
+		q := e.question(t, token, constID)
+		body := submission(constID, q, solve(t, constID, q), "temporary-outage")
+		before, err := e.store.GetAllAttempts()
+		if err != nil {
+			t.Fatal(err)
+		}
+		progressBefore, _ := e.store.GetAllProgress(student)
+		node := check.node
+		check.node = filepath.Join(t.TempDir(), "missing-node")
+		defer func() { check.node = node }()
+		res, raw := e.request(t, "POST", "/api/study/answer", token, body, 200)
+		check.node = node
+		if res["ungraded"] != true {
+			t.Errorf("HTTP response must distinguish infrastructure failure from an incorrect answer: %s", raw)
+		}
+		after, err := e.store.GetAllAttempts()
+		progressAfter, _ := e.store.GetAllProgress(student)
+		if err != nil || !reflect.DeepEqual(before, after) || !reflect.DeepEqual(progressBefore, progressAfter) {
+			t.Fatal("compiler outage penalized the learner")
+		}
+		res, raw = e.request(t, "POST", "/api/study/answer", token, body, 200)
+		if res["correct"] != true || res["ungraded"] == true {
+			t.Fatalf("retry after recovery failed: %s", raw)
+		}
+	})
+}
+
+func TestNativeRepairOfHistoricalFalseNegative(t *testing.T) {
+	e := boot(t, filepath.Join(t.TempDir(), "repair.db"), testChecker(t))
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	_, student, err := auth.New(e.store).Signup("Fixture", "fixture", "Repair-test-159!")
+	if err != nil {
+		t.Fatal(err)
+	}
+	session, err := e.store.CreateSession(student.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// This fixture simulates a historical overly strict grader. The pilot itself
+	// never rejects the omitted annotation when the prompt makes it optional.
+	_, err = e.store.RecordAttempt(storage.AttemptEntry{SessionID: session.ID, StudentID: student.ID, ConceptID: constID,
+		Answer: "const amount = 15000;", Expected: "const amount: number = 15000;", Correct: false,
+		Question:       "Declare somente uma constante chamada amount, inicializada com o literal numérico 15000. A anotação number é opcional.",
+		ElapsedSeconds: 30, Timestamp: time.Now().UTC(), Source: "practice"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, _ := e.store.GetAllAttempts()
+	dry, err := repair.Run(e.eng, e.store, e.eng.GetDAG(), true, io.Discard)
+	if err != nil || dry.Repaired != 1 || dry.ProgressWrites != 0 {
+		t.Fatalf("repair preview: %+v, %v", dry, err)
+	}
+	afterPreview, _ := e.store.GetAllAttempts()
+	if !reflect.DeepEqual(before, afterPreview) {
+		t.Fatal("dry run changed attempts")
+	}
+	applied, err := repair.Run(e.eng, e.store, e.eng.GetDAG(), false, io.Discard)
+	after, _ := e.store.GetAllAttempts()
+	updatedStudent, _ := e.store.GetStudent(student.ID)
+	if err != nil || applied.Repaired != 1 || applied.ProgressWrites != 1 || !after[0].Correct || updatedStudent.XPTotal != student.XPTotal {
+		t.Fatalf("native repair: %+v, error=%v, attempts=%+v", applied, err, after)
+	}
+	progress, err := e.store.GetProgress(student.ID, constID)
+	if err != nil || progress.Attempts != 1 || progress.Status == "MASTERED" {
+		t.Fatalf("repair invented mastery: %+v, %v", progress, err)
+	}
+}
