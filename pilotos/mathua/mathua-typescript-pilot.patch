+func TestNativeRepairOfHistoricalFalseNegative(t *testing.T) {
+	e := boot(t, filepath.Join(t.TempDir(), "repair.db"), testChecker(t))
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	_, student, err := auth.New(e.store).Signup("Fixture", "fixture", "Repair-test-159!")
