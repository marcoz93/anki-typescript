+type pilotEnv struct {
+	http  *httptest.Server
+	store *storage.SQLiteStore
+	eng   *engine.Engine
+}
+
+func boot(t *testing.T, db string, check *checker) *pilotEnv {
+	t.Helper()
+	store, err := storage.NewSQLiteStore(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contentDir, _ := testContent(t)
+	mux, eng, _, err := newPilot(store, check, contentDir, t.TempDir())
+	if err != nil {
+		store.Close()
+		t.Fatal(err)
+	}
+	e := &pilotEnv{http: httptest.NewServer(mux), store: store, eng: eng}
+	return e
+}
+
+func (e *pilotEnv) request(t *testing.T, method, route, token string, body any, wantStatus int) (map[string]any, string) {
+	t.Helper()
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	req, err := http.NewRequest(method, e.http.URL+route, bytes.NewReader(encoded))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	client := &http.Client{Timeout: 15 * time.Second}
+	res, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	data, err := io.ReadAll(res.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.StatusCode != wantStatus {
+		t.Fatalf("%s %s: status %d, want %d: %s", method, route, res.StatusCode, wantStatus, data)
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatalf("JSON: %v: %s", err, data)
+	}
+	return decoded, string(data)
+}
+
+func (e *pilotEnv) question(t *testing.T, token, concept string, excluded ...string) string {
+	t.Helper()
+	query := url.Values{"count": {"1"}}
+	for _, q := range excluded {
+		query.Add("exclude", q)
+	}
+	res, raw := e.request(t, "GET", "/api/lessons/"+concept+"/practice?"+query.Encode(), token, nil, 200)
+	questions := res["questions"].([]any)
+	if len(questions) != 1 {
+		t.Fatalf("want one question: %s", raw)
+	}
+	q := questions[0].(map[string]any)
+	if _, exposed := q["answer"]; exposed || q["answer_input_mode"] != "text" {
+		t.Fatalf("answer leaked or input excludes TypeScript: %s", raw)
+	}
+	return q["question"].(string)
+}
+
+func submission(concept, question, answer, id string) map[string]any {
+	return map[string]any{"concept_id": concept, "question": question, "answer": answer, "submission_id": id, "elapsed": 30}
+}
+
+// Test answers come from the content package, found by the served prompt. The client never reads
+// an anchor. The const answer drops the optional annotation, so it differs from the model answer.
+func solve(t *testing.T, concept, question string) string {
+	t.Helper()
+	_, c := testContent(t)
+	familyID, caseID, ok := c.lookup(concept, question)
+	if !ok {
+		t.Fatalf("cannot answer prompt: %s", question)
+	}
+	for _, k := range c.families[familyID].Cases {
+		if k.ID == caseID {
+			if concept == constID {
+				return strings.Replace(k.Answer, ": number", "", 1)
+			}
+			return k.Answer
+		}
+	}
+	t.Fatalf("case %s not found", caseID)
+	return ""
+}
