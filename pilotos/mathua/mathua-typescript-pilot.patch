+// Every served case of F015 to F025, each judged with its own context: the model answer is
+// accepted, and the equivalence or the refusal the contract names for its family holds too.
+func TestCriteriaHoldInEveryCaseOfStagesFourAndFive(t *testing.T) {
+	_, c := testContent(t)
+	var (
+		comparison = regexp.MustCompile(`^(\w+) > (\d+)$`)
+		equality   = regexp.MustCompile(`^(\w+) === "(\w+)"$`)
+		conjunct   = regexp.MustCompile(`^(\w+) && (\w+)$`)
+		object     = regexp.MustCompile(`^const (\w+) = \{ (id: "\w+"), (\w+: \d+) \};$`)
+		access     = regexp.MustCompile(`^(\w+)\.(\w+)$`)
+		array      = regexp.MustCompile(`^const (\w+) = \[(\d+), (\d+), (\d+)\];$`)
+	)
+	rows := []criterion{}
+	add := func(k exerciseCase, name, answer string, correct bool) {
+		rows = append(rows, criterion{k.ID + "_" + name, k.ID, answer, correct, ""})
+	}
+	for n := 15; n <= 25; n++ {
+		f := c.families[fmt.Sprintf("F%03d", n)]
+		if f == nil {
+			t.Fatalf("F%03d is not served", n)
+		}
+		for _, k := range f.Cases {
+			// For a choice this is the text of the correct alternative, as the engine resolves it.
+			add(k, "model_answer", expectedText(f, k), true)
+			m := func(re *regexp.Regexp) []string {
+				parts := re.FindStringSubmatch(k.Answer)
+				if parts == nil {
+					t.Fatalf("%s: model answer %q has another form", k.ID, k.Answer)
+				}
+				return parts
+			}
+			switch f.ID {
+			case "F015", "F025":
+				// The engine resolves a letter to its text; each other alternative is refused.
+				for _, option := range k.Choices {
+					if option.ID != k.Answer {
+						add(k, "alternative_"+option.ID, option.Text, false)
+					}
+				}
+			case "F016":
+				p := m(comparison)
+				add(k, "limit_on_the_left", p[2]+" < "+p[1], true)
+				add(k, "greater_or_equal", p[1]+" >= "+p[2], false)
+			case "F017", "F024":
+				add(k, "quoted_value", `"`+k.Answer+`"`, false)
+				add(k, "context_expression_instead_of_value", strings.TrimSpace(k.ContextCode[strings.LastIndex(k.ContextCode, "\n")+1:]), false)
+			case "F018":
+				p := m(equality)
+				add(k, "swapped_single_quotes", "'"+p[2]+"' === "+p[1], true)
+				add(k, "loose_equality", p[1]+` == "`+p[2]+`"`, false)
+			case "F019":
+				p := m(conjunct)
+				add(k, "order_swapped", p[2]+" && "+p[1], true)
+				add(k, "disjunction", p[1]+" || "+p[2], false)
+			case "F020":
+				add(k, "without_negation", strings.TrimPrefix(k.Answer, "!"), false)
+			case "F021":
+				p := m(object)
+				add(k, "properties_in_other_order", "const "+p[1]+" = { "+p[3]+", "+p[2]+" }", true)
+				add(k, "positional_array", "const "+p[1]+" = ["+strings.SplitN(p[2], ": ", 2)[1]+", "+strings.SplitN(p[3], ": ", 2)[1]+"];", false)
+			case "F022":
+				p := m(access)
+				add(k, "brackets", p[1]+`['`+p[2]+`']`, true)
+				add(k, "other_property", p[1]+".id", false)
+			case "F023":
+				p := m(array)
+				add(k, "reversed", "const "+p[1]+" = ["+p[4]+", "+p[3]+", "+p[2]+"];", false)
+				separated := regexp.MustCompile(`(\d)(\d{3})$`)
+				elements := []string{}
+				for _, n := range p[2:5] {
+					elements = append(elements, separated.ReplaceAllString(n, "${1}_${2}"))
+				}
+				add(k, "separators_no_semicolon", "const "+p[1]+" = ["+strings.Join(elements, ", ")+"]", true)
+			}
+		}
+	}
+	judge(t, testChecker(t), rows)
+}
+
+// A new learner walks the whole served ladder through the real HTTP API, in the order of the
+// content package: six distinct questions per concept, each answered with its model answer.
+// Every concept must be open once its prerequisites are mastered, and end MASTERED.
+func TestWholeLadderThroughTheAPI(t *testing.T) {
+	t.Setenv("MATHUA_DEV_UNLOCK", "")
+	_, c := testContent(t)
+	e := boot(t, filepath.Join(t.TempDir(), "ladder.db"), testChecker(t))
+	t.Cleanup(func() { e.http.Close(); e.eng.Close(); e.store.Close() })
+	guest, _ := e.request(t, "POST", "/api/auth/guest", "", map[string]any{}, 200)
+	token, student := guest["token"].(string), guest["student_id"].(string)
+	mastered := map[string]bool{}
+	// Before any answer, a concept with prerequisites is locked.
+	for _, spec := range c.Concepts {
+		if len(spec.Prerequisites) == 0 {
+			continue
+		}
+		ready, raw := e.request(t, "GET", "/api/lessons/"+spec.ID+"/readiness", token, nil, 200)
+		if ready["eligible"] != false {
+			t.Fatalf("%s is open before its prerequisites: %s", spec.ID, raw)
+		}
+	}
+	for _, spec := range c.Concepts {
+		for _, p := range spec.Prerequisites {
+			if !mastered[p] {
+				t.Fatalf("%s comes before its prerequisite %s in the content order", spec.ID, p)
+			}
+		}
+		ready, raw := e.request(t, "GET", "/api/lessons/"+spec.ID+"/readiness", token, nil, 200)
+		if ready["eligible"] != true {
+			t.Fatalf("%s stays locked with every prerequisite mastered: %s", spec.ID, raw)
+		}
+		seen := []string{}
+		families := map[string]int{}
+		for i := 0; i < mastery.MasteryEvidenceFloor; i++ {
+			q := e.question(t, token, spec.ID, seen...)
+			for _, previous := range seen {
+				if previous == q {
+					t.Fatalf("%s repeated a question before six distinct ones", spec.ID)
+				}
+			}
+			seen = append(seen, q)
+			familyID, _, _ := c.lookup(spec.ID, q)
+			families[familyID]++
+			answer := solve(t, spec.ID, q)
+			res, raw := e.request(t, "POST", "/api/study/answer", token, submission(spec.ID, q, answer, fmt.Sprintf("%s-%d", spec.ID, i)), 200)
+			if res["correct"] != true || res["ungraded"] == true {
+				t.Fatalf("%s answer %d %q: %s", spec.ID, i, answer, raw)
+			}
+			if i < mastery.MasteryEvidenceFloor-1 && res["new_status"] == "MASTERED" {
+				t.Fatalf("%s mastered after %d answers", spec.ID, i+1)
+			}
+		}
+		progress, err := e.store.GetProgress(student, spec.ID)
+		if err != nil || progress.Status != "MASTERED" {
+			t.Fatalf("%s: progress = %+v, error=%v", spec.ID, progress, err)
+		}
+		mastered[spec.ID] = true
+		t.Logf("%s: %d distinct questions, families %v, status %s", spec.ID, len(seen), families, progress.Status)
+	}
+	if len(mastered) != len(c.Concepts) {
+		t.Fatalf("mastered %d of %d concepts", len(mastered), len(c.Concepts))
+	}
+}
